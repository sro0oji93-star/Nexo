<%- include('partials/header') %>

<div class="page-hero cart-hero" style="background:linear-gradient(135deg,rgba(35,34,35,.5),rgba(35,34,35,.3)),url('/images/cart-hero.jpg') center/cover">
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content">
    <div class="page-hero-badge">WARENKORB</div>
    <h1 class="page-hero-title" style="color:#fff">Ihr Warenkorb</h1>
    <p class="page-hero-subtitle" style="color:rgba(255,255,255,.7)">Überprüfen Sie Ihre Bestellung</p>
  </div>
</div>

<section class="section cart-section">
  <div class="container">
    <div class="cart-layout">
      <div class="cart-items" id="cartItems">
        <div class="cart-empty" id="cartEmpty">
          <div class="cart-empty-icon"><i class="fas fa-shopping-bag"></i></div>
          <h3>Ihr Warenkorb ist leer</h3>
          <p>Entdecken Sie unsere Speisekarte und fügen Sie Gerichte hinzu.</p>
          <a href="/speisekarte" class="btn btn-primary">Zur Speisekarte</a>
        </div>
        <div class="cart-list" id="cartList" style="display:none;"></div>
      </div>
      <div class="cart-summary" id="cartSummary" style="display:none;">
        <h3>Bestellübersicht</h3>
        <div class="summary-row" style="font-size:12px;color:#7a7879;justify-content:flex-end"><span>inkl. MwSt.</span></div>
        <div class="summary-row"><span>Zwischensumme</span><span id="cartSubtotal">0,00 €</span></div>
        <div class="summary-row" id="discountRow" style="display:none;">
          <span>Rabatt</span>
          <span id="cartDiscount" class="summary-discount">−0,00 €</span>
        </div>
        <div class="summary-row" id="cartDeliveryRow"><span>Liefergebühr</span><span id="cartDelivery">0,00 €</span></div>
        <div class="summary-divider"></div>
        <div class="summary-row summary-total"><span>Gesamt</span><span id="cartTotal">0,00 €</span></div>
        <%- include('partials/vat-note') %>

        <div class="coupon-section">
          <h4>Rabattcode</h4>
          <div class="coupon-input">
            <input type="text" id="couponCode" placeholder="Code eingeben" maxlength="20">
            <button class="btn btn-outline btn-sm" id="applyCoupon">Einlösen</button>
          </div>
          <p class="coupon-message" id="couponMessage"></p>
        </div>

        <a href="/bestellung" class="btn btn-primary btn-block" id="checkoutBtn">
          <i class="fas fa-lock"></i> Zur Kasse
        </a>
        <a href="/speisekarte" class="btn btn-primary btn-block">Weitere Gerichte entdecken</a>
      </div>
    </div>
  </div>
</section>

<script>
  window.discounts = <%- JSON.stringify(typeof discounts !== 'undefined' ? discounts : []) %>;
  window.restaurantSettings = {
    delivery_fee: <%- (typeof settings !== 'undefined' && settings.delivery_fee ? parseFloat(settings.delivery_fee) : 4.50) %>,
    free_delivery_from: <%- (typeof settings !== 'undefined' && settings.free_delivery_from ? parseFloat(settings.free_delivery_from) : 40.00) %>
  };
</script>

<%- include('partials/footer') %>
