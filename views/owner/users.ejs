<%- include('layout') %>
<div class="section-header-row">
  <h2><i class="fas fa-users"></i> Benutzer</h2>
</div>

<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
<% } %>
<% if (typeof success !== 'undefined' && success) { %>
<div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div>
<% } %>

<div class="table-container" style="margin-bottom:24px">
  <table class="admin-table card-mobile">
    <thead><tr><th>Benutzername</th><th>Name</th><th>Rolle</th><th>Aktionen</th></tr></thead>
    <tbody>
      <% users.forEach(function(u) { %>
      <tr>
        <td data-label="Benutzername"><strong><%= u.username %></strong></td>
        <td data-label="Name"><%= u.display_name || '' %></td>
        <td data-label="Rolle"><%= u.role === 'owner' ? '👑 Eigentümer' : '🧑‍🍳 Manager (/admin)' %></td>
        <td data-label="Aktionen">
          <% if (u.role !== 'owner') { %>
          <form method="POST" action="/eigentuemer/benutzer/<%= u.id %>/passwort" style="display:inline-flex;gap:6px;align-items:center">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="password" name="password" placeholder="Neues Passwort (min. 8)" minlength="8" required style="padding:8px 12px;border-radius:8px;border:1px solid #e8e4de;font-size:13px">
            <button type="submit" class="btn btn-small btn-secondary">Passwort setzen</button>
          </form>
          <form method="POST" action="/eigentuemer/benutzer/<%= u.id %>/loeschen" style="display:inline" onsubmit="return confirm('Benutzer wirklich löschen?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-small btn-danger">Löschen</button>
          </form>
          <% } else { %>
          <small style="color:#6b6b6b">–</small>
          <% } %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="settings-card" style="margin-bottom:24px">
  <h3>Neuer Manager (Login über /admin)</h3>
  <form method="POST" action="/eigentuemer/benutzer">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="form-group"><label>Benutzername</label><input type="text" name="username" required minlength="3" placeholder="z.B. restaurant"></div>
      <div class="form-group"><label>Anzeigename</label><input type="text" name="display_name" placeholder="z.B. Restaurant"></div>
      <div class="form-group"><label>Passwort (min. 8 Zeichen)</label><input type="password" name="password" required minlength="8" placeholder="••••••••"></div>
    </div>
    <button type="submit" class="btn btn-primary" style="margin-top:12px">Manager erstellen</button>
  </form>
</div>

<div class="settings-card">
  <h3>Eigenes Eigentümer-Passwort ändern</h3>
  <form method="POST" action="/eigentuemer/passwort">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="form-group"><label>Aktuelles Passwort</label><input type="password" name="current_password" required placeholder="••••••••"></div>
      <div class="form-group"><label>Neues Passwort (min. 8 Zeichen)</label><input type="password" name="new_password" required minlength="8" placeholder="••••••••"></div>
    </div>
    <button type="submit" class="btn btn-primary" style="margin-top:12px">Passwort ändern</button>
  </form>
</div>
<%- include('footer') %>
