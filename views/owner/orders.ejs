<%- include('layout') %>
<div class="section-header-row">
  <h2><i class="fas fa-clipboard-list"></i> Alle Bestellungen – <%= datum %></h2>
  <form method="GET" action="/eigentuemer/bestellungen" class="date-filter">
    <input type="date" name="datum" value="<%= datum %>">
    <button type="submit" class="btn btn-primary">Anzeigen</button>
  </form>
</div>

<div class="owner-cards">
  <div class="owner-card">
    <div class="v"><%= received %></div>
    <div class="l">Eingegangen (alle)</div>
  </div>
  <div class="owner-card">
    <div class="v"><%= received - deleted %></div>
    <div class="l">Aktiv</div>
  </div>
  <div class="owner-card">
    <div class="v"><%= deleted %></div>
    <div class="l">Gelöscht</div>
  </div>
  <div class="owner-card">
    <div class="v"><%= parseFloat(onlineRevenue).toFixed(2) %> €</div>
    <div class="l">Online Umsatz Tag</div>
  </div>
  <div class="owner-card">
    <div class="v"><%= parseFloat(kasseRevenue).toFixed(2) %> €</div>
    <div class="l">Kasse Umsatz Tag</div>
  </div>
  <div class="owner-card gold">
    <div class="v"><%= parseFloat(commission).toFixed(2) %> €</div>
    <div class="l">Provision (<%= onlineReceived %> × <%= rate.toFixed(2) %> €, nur online)</div>
  </div>
</div>

<div class="table-container">
  <table class="admin-table card-mobile">
    <thead><tr><th>Nr.</th><th>Zeit</th><th>Kunde</th><th>Artikel</th><th>Typ</th><th>Gesamt</th><th>Status</th><th>Aktion</th></tr></thead>
    <tbody>
      <% if (!orders || orders.length === 0) { %>
      <tr><td colspan="8" class="empty-state">Keine Bestellungen an diesem Tag.</td></tr>
      <% } %>
      <% orders.forEach(function(o) { %>
      <tr class="<%= o.is_deleted ? 'row-deleted' : '' %>">
        <td data-label="Nr."><strong><%= o.order_number %></strong><% if (o.is_deleted) { %><br><span class="badge-deleted">Gelöscht</span><% } %><% if (o.order_source === 'telefon' || o.payment_method === 'telefon') { %><br><span style="background:#fef3c7;color:#92400e;border:1px solid #92400e;padding:1px 8px;border-radius:8px;font-size:12px;font-weight:700">Telefon</span><% } else if (o.order_source === 'theke' || (o.customer_name === 'Theke' && o.notes === 'Theken-Bestellung')) { %><br><span style="background:#f1f5f9;color:#475569;border:1px solid #94a3b8;padding:1px 8px;border-radius:8px;font-size:12px;font-weight:700">Theke</span><% } %></td>
        <td data-label="Zeit"><%= new Date(o.created_at).toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' }) %><% if (o.wish_display) { %><br><small style="color:#15803d;font-weight:700">Wunsch: <%= o.wish_display %></small><% } %></td>
        <td data-label="Kunde"><%= o.customer_name %><br><small><%= o.customer_phone || '' %></small></td>
        <td data-label="Artikel">
          <% (o.itemsParsed || []).forEach(function(it) { %>
          <div><%= it.qty %>× <%= it.name %><% if (it.size && it.size.label) { %> (<%= it.size.label %>)<% } %></div>
          <% }); %>
          <div class="items-mini"><%= parseFloat(o.total).toFixed(2) %> € via <%= o.payment_method === 'bar' ? 'Bar' : (o.payment_method === 'karte' ? 'Karte' : (o.payment_method === 'telefon' ? 'Telefon' : 'Online')) %></div>
        </td>
        <td data-label="Typ"><%= o.order_type === 'abholung' ? 'Abholung' : 'Lieferung' %></td>
        <td data-label="Gesamt"><strong><%= parseFloat(o.total).toFixed(2) %> €</strong></td>
        <td data-label="Status">
          <form method="POST" action="/eigentuemer/bestellungen/status/<%= o.id %>" class="status-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="datum" value="<%= datum %>">
            <select name="status" onchange="this.form.submit()">
              <option value="wartet_auf_zahlung" <%= o.order_status === 'wartet_auf_zahlung' ? 'selected' : '' %>>Wartet auf Zahlung</option>
              <option value="neu" <%= o.order_status === 'neu' ? 'selected' : '' %>>Neu</option>
              <option value="in_bearbeitung" <%= o.order_status === 'in_bearbeitung' ? 'selected' : '' %>>In Bearbeitung</option>
              <option value="unterwegs" <%= o.order_status === 'unterwegs' ? 'selected' : '' %>>Unterwegs</option>
              <option value="geliefert" <%= o.order_status === 'geliefert' ? 'selected' : '' %>>Geliefert</option>
              <option value="zugestellt" <%= o.order_status === 'zugestellt' ? 'selected' : '' %>>Zugestellt (Fahrer)</option>
              <option value="storniert" <%= o.order_status === 'storniert' ? 'selected' : '' %>>Storniert</option>
            </select>
          </form>
        </td>
        <td data-label="Aktion">
          <form method="POST" action="/eigentuemer/bestellungen/loeschen/<%= o.id %>" style="display:inline" onsubmit="return confirm('Wirklich löschen?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="datum" value="<%= datum %>">
            <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<%- include('footer') %>
