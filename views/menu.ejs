                <% } else { %>
                <% if (p.sizes) { var sizeData = JSON.parse(p.sizes); %>
                <% if (cat.slug === 'croque' || cat.slug === 'salat' || cat.slug === 'rings') { %><%- include('partials/croque-sauces', { productId: p.id, sizeData: sizeData }) %><% } else if (cat.slug === 'schnitzel' || cat.slug === 'bowls') { %><%- include('partials/croque-sauces', { productId: p.id, sizeData: sizeData, boxTitle: '1 Beilage nach Wahl' }) %><% } else if (cat.slug === 'burger') { %><%- include('partials/burger-menue', { productId: p.id, productName: p.name, sizeData: sizeData }) %><% } else { %>
                <div class="size-picker" style="margin-top:10px;display:flex;flex-wrap:wrap;gap:6px">
                  <% sizeData.forEach(function(s) { %>
                  <label class="size-option" style="cursor:pointer;padding:6px 14px;border:2px solid #3a3a41;border-radius:10px;font-size:13px;transition:all .25s ease;background:#1d1d21;color:#f0ead8;box-shadow:0 1px 4px rgba(0,0,0,0.4);text-align:center">
                    <input type="radio" name="size_<%= p.id %>" value="<%= s.price %>" data-label="<%= s.label %>" data-id="<%= p.id %>" data-name="<%= p.name %>" style="display:none" <%= sizeData.indexOf(s) === 0 ? 'checked' : '' %>>
                    <span style="display:block;font-weight:600;font-size:13px"><%= s.label %></span>
                    <span class="size-price" style="display:block;color:var(--primary);font-weight:700;font-size:12px"><%= s.price.toFixed(2) %>€</span>
                  </label>
                  <% }); %>
                </div>
                <% } %>
                <% if (cat.slug === 'snacks') { %><%- include('partials/snacks-menue', { productId: p.id }) %><% } %>
                <% if (cat.slug === 'bowls') { %><%- include('partials/bowls-sauces', { productId: p.id }) %><% } %>
                <% if (cat.slug === 'pizza-broetchen') { %><%- include('partials/free-sauce', { productId: p.id }) %><% } %>
                <% if (['crepe-nutella','crepe-frucht','crepe-lotus','crepe-oreo','crepe-bueno','mini-pancakes','mini-waffel'].indexOf(p.slug) !== -1) { %><%- include('partials/choco-box', { productId: p.id }) %><% } %>
                <% if (cat.slug === 'pizza') { %><%- include('partials/pizza-extras', { productId: p.id }) %><% } %>
                <% if (cat.slug === 'burger') { %><button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" data-has-menue="1" style="margin-top:8px">In den Warenkorb</button><% } else { %>                <% if (cat.slug === 'snacks') { %><button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-has-snacks-menue="1" style="margin-top:8px">In den Warenkorb</button><% } else if (cat.slug === 'pizza-broetchen') { %><button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" data-has-sauce="1" style="margin-top:8px">In den Warenkorb</button><% } else { %><button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-has-sizes="1" style="margin-top:8px">In den Warenkorb</button><% } %><% } %>
                <% } else if (p.slug === 'nexo-mittag-deal') { %>
                <%- include('partials/deal-choices', { productId: p.id, dealLists: typeof dealLists !== 'undefined' ? dealLists : null }) %>
                <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" data-has-deal="1" data-deal-slug="nexo-mittag-deal"<%- dealWindows[p.slug] ? ' data-deal-from="' + dealWindows[p.slug].from + '" data-deal-to="' + dealWindows[p.slug].to + '" data-deal-hint="' + dealWindows[p.slug].hint + '"' : '' %> style="margin-top:8px">In den Warenkorb</button><% } else if (p.boxGroups) { %>
                <%- include('partials/box-choices', { productId: p.id, boxSlug: p.slug, boxGroups: p.boxGroups }) %>
                <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" data-has-box="1" data-box-slug="<%= p.slug %>" style="margin-top:8px">In den Warenkorb</button>
                <% } else if (['crepe-nutella','crepe-frucht','crepe-lotus','crepe-oreo','crepe-bueno','mini-pancakes','mini-waffel'].indexOf(p.slug) !== -1) { %>
                <%- include('partials/choco-box', { productId: p.id }) %>
                <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" data-has-choco="1" style="margin-top:8px">In den Warenkorb</button>
                <% } else if (cat.slug === 'pasta') { %>
                <%- include('partials/pasta-type', { productId: p.id, showSauce: p.slug === 'pasta-wunsch' }) %>
                <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" data-has-pasta="1" style="margin-top:8px">In den Warenkorb</button>
                <% } else { %>
                <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>"<%- dealWindows[p.slug] ? ' data-deal-from="' + dealWindows[p.slug].from + '" data-deal-to="' + dealWindows[p.slug].to + '" data-deal-hint="' + dealWindows[p.slug].hint + '"' : '' %><%- p.slug === 'nexo-night-deal' ? ' data-pickup-only="1"' : '' %> style="margin-top:8px">In den Warenkorb</button>
                <% } %>
                <% } %>
              </div>
            </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
  <% }); %>
  <p class="align-center" style="color:#7a7879;font-size:12px;margin:10px auto;max-width:700px">Alle Preise inkl. MwSt. – Speisen 7 %, Getränke 19 %.</p>
</div>

<style>
@media (max-width: 767px) {
  .mad-spec-item { flex-direction:column !important; align-items:center !important; text-align:center !important; }
  .mad-spec-item figure { max-width:70px !important; min-width:70px !important; height:70px !important; margin-right:0 !important; margin-bottom:12px !important; }
  .mad-spec-header { flex-direction:column !important; align-items:center !important; }
  .mad-line { display:none !important; }
  .mad-spec-title { padding:0 !important; text-align:center !important; }
  .mad-spec-price { padding:0 !important; margin-top:4px !important; }
  .size-option { padding:10px 18px !important; font-size:14px !important; min-width:70px !important; }
  /* Alle Größen (z.B. Pizza 26/30/Familie/Party) in einer Reihe auf dem Handy */
  .size-picker { flex-wrap:nowrap !important; gap:4px !important; }
  .size-picker .size-option { flex:1 1 0 !important; min-width:0 !important; padding:8px 2px !important; font-size:11px !important; }
  .size-picker .size-option span { font-size:11px !important; }
  .btn-small { font-size:13px !important; padding:6px 14px !important; }
}
</style>
<script>
// Früher scrollen: DOMContentLoaded statt load – nicht erst alle Bilder abwarten.
document.addEventListener('DOMContentLoaded', function(){
  var el = document.getElementById('produkte');
  if (!el) return;
<% if (activeCategory) { %>
  el.scrollIntoView({ behavior:'smooth', block:'start' });
<% } else { %>
  // Banner zuerst zeigen, dann nach kurzer Pause sanft zu den Produkten scrollen.
  // Abbrechen, wenn der Nutzer selbst schon gescrollt hat.
  setTimeout(function(){
    if ((window.scrollY || 0) < 60) el.scrollIntoView({ behavior:'smooth', block:'start' });
  }, 400);
<% } %>
});
</script>
<script>
document.querySelectorAll('.size-picker').forEach(function(picker) {
  function paintSelected(label) {
    label.style.borderColor = 'var(--primary)';
    label.style.background = '#2a230f';
    label.style.boxShadow = '0 0 0 3px rgba(212,175,55,0.25)';
    label.dataset.selected = '1';
  }
  function paintPlain(l) {
    l.style.borderColor = '#3a3a41';
    l.style.background = '#1d1d21';
    l.style.boxShadow = '0 1px 4px rgba(0,0,0,0.4)';
    delete l.dataset.selected;
  }
  var first = picker.querySelector('input[type="radio"]');
  if (first) {
    var label = first.closest('.size-option');
    if (label) paintSelected(label);
  }
  picker.querySelectorAll('input[type="radio"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      picker.querySelectorAll('.size-option').forEach(function(l) { paintPlain(l); });
      var label = this.closest('.size-option');
      if (label) paintSelected(label);
    });
  });
  // Hover effect
  picker.querySelectorAll('.size-option').forEach(function(l) {
    l.addEventListener('mouseenter', function() {
      if (!this.dataset.selected) { this.style.borderColor = '#6b6455'; }
    });
    l.addEventListener('mouseleave', function() {
      if (!this.dataset.selected) { this.style.borderColor = '#3a3a41'; }
    });
  });
});
</script>
<%- include('partials/footer') %>