<%- include('layout') %>
<div class="section-header-row">
  <h2><i class="fas fa-cog"></i> Einstellungen</h2>
</div>

<% if (typeof success !== 'undefined' && success) { %>
<div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div>
<% } %>

<form method="POST" action="/admin/einstellungen" class="settings-form">
  <div class="settings-card">
    <h3>Allgemein</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>Restaurantname</label>
        <input type="text" name="site_name" value="<%= settings.site_name || '' %>">
      </div>
      <div class="form-group">
        <label>Beschreibung</label>
        <input type="text" name="site_description" value="<%= settings.site_description || '' %>">
      </div>
    </div>
  </div>

  <div class="settings-card">
    <h3>Kontaktdaten</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>Adresse</label>
        <input type="text" name="address" value="<%= settings.address || '' %>">
      </div>
      <div class="form-group">
        <label>Telefon</label>
        <input type="text" name="phone" value="<%= settings.phone || '' %>">
      </div>
      <div class="form-group">
        <label>E-Mail</label>
        <input type="email" name="email" value="<%= settings.email || '' %>">
      </div>
      <div class="form-group">
        <label>Öffnungszeiten</label>
        <input type="text" name="opening_hours" value="<%= settings.opening_hours || '' %>">
      </div>
      <div class="form-group">
        <label>Breitengrad (Map)</label>
        <input type="text" name="latitude" value="<%= settings.latitude || '' %>">
      </div>
      <div class="form-group">
        <label>Längengrad (Map)</label>
        <input type="text" name="longitude" value="<%= settings.longitude || '' %>">
      </div>
    </div>
  </div>

  <div class="settings-card">
    <h3>Impressum (rechtlich erforderlich)</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>Firmenname</label>
        <input type="text" name="impressum_company" value="<%= settings.impressum_company || '' %>" placeholder="z.B. NEXO">
      </div>
      <div class="form-group">
        <label>Inhaber (Vor- und Nachname) *</label>
        <input type="text" name="impressum_owner" value="<%= settings.impressum_owner || '' %>" placeholder="z.B. Max Mustermann">
      </div>
      <div class="form-group">
        <label>Rechtsform</label>
        <input type="text" name="impressum_legal_form" value="<%= settings.impressum_legal_form || '' %>" placeholder="z.B. Einzelunternehmen">
      </div>
      <div class="form-group">
        <label>USt-IdNr. (optional, nachtragen sobald vorhanden)</label>
        <input type="text" name="ust_idnr" value="<%= settings.ust_idnr || '' %>" placeholder="z.B. DE123456789">
      </div>
      <div class="form-group">
        <label>Handelsregister (optional)</label>
        <input type="text" name="impressum_register" value="<%= settings.impressum_register || '' %>" placeholder="z.B. HRA 12345, AG Lüneburg">
      </div>
    </div>
    <p style="font-size:12px;color:#6b6b6b;margin-top:6px">Adresse, Telefon und E-Mail werden aus „Kontaktdaten" übernommen. Leere optionale Felder erscheinen nicht im Impressum.</p>
  </div>

  <div class="settings-card">
    <h3>Lieferung</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>Liefergebühr (€, ohne Zone)</label>
        <input type="number" step="0.01" name="delivery_fee" value="<%= settings.delivery_fee || '0' %>">
      </div>
      <div class="form-group">
        <label>Kostenfreie Lieferung ab (€, ohne Zone)</label>
        <input type="number" step="0.01" name="free_delivery_from" value="<%= settings.free_delivery_from || '0' %>">
      </div>
      <div class="form-group">
        <label>Maximale Lieferentfernung (km, Fahrstrecke)</label>
        <input type="number" step="0.5" min="1" name="max_delivery_km" value="<%= settings.max_delivery_km || '15' %>">
      </div>
    </div>
    <h4 style="margin-top:18px">Lieferzonen (Fahrstrecke)</h4>
    <table class="admin-table" id="zonesTable">
      <thead><tr><th>Bis (km)</th><th>Mindestbestellwert (€)</th><th>Lieferkosten (€)</th><th>Gratis ab (€, leer = nie)</th></tr></thead>
      <tbody>
        <% (typeof zones !== 'undefined' && zones ? zones : []).forEach(function(z) { %>
        <tr>
          <td><input type="number" step="0.5" min="0.5" name="zone_to" value="<%= z.to %>" style="width:90px;padding:6px 8px"></td>
          <td><input type="number" step="0.01" min="0" name="zone_min" value="<%= z.min %>" style="width:90px;padding:6px 8px"></td>
          <td><input type="number" step="0.01" min="0" name="zone_fee" value="<%= z.fee %>" style="width:90px;padding:6px 8px"></td>
          <td><input type="number" step="0.01" min="0" name="zone_free" value="<%= z.free ? z.free : '' %>" placeholder="—" style="width:90px;padding:6px 8px"></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <p style="font-size:12px;color:#6b6b6b;margin-top:6px">Zeilen werden nach Entfernung sortiert. Ungültige Zeilen werden ignoriert.</p>
  </div>

  <div class="settings-card">
    <h3>Liefergebiet (Startpunkt)</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>Restaurant-Breitengrad</label>
        <input type="text" name="restaurant_lat" value="<%= settings.restaurant_lat || settings.latitude || '' %>">
      </div>
      <div class="form-group">
        <label>Restaurant-Längengrad</label>
        <input type="text" name="restaurant_lon" value="<%= settings.restaurant_lon || settings.longitude || '' %>">
      </div>
    </div>
  </div>

  <div class="settings-card">
    <h3>Social Media</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>Instagram URL</label>
        <input type="url" name="social_instagram" value="<%= settings.social_instagram || '' %>">
      </div>
      <div class="form-group">
        <label>Facebook URL</label>
        <input type="url" name="social_facebook" value="<%= settings.social_facebook || '' %>">
      </div>
      <div class="form-group">
        <label>TikTok URL</label>
        <input type="url" name="social_tiktok" value="<%= settings.social_tiktok || '' %>">
      </div>
    </div>
  </div>

  <div class="settings-card">
    <h3>Startseite</h3>
    <div class="form-group">
      <label>Über uns - Titel</label>
      <input type="text" name="about_title" value="<%= settings.about_title || '' %>">
    </div>
    <div class="form-group">
      <label>Über uns - Text</label>
      <textarea name="about_text" rows="4"><%= settings.about_text || '' %></textarea>
    </div>
  </div>

  <div class="settings-card">
    <h3>Design 🎨</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>Primärfarbe (Buttons, Preise)</label>
        <input type="color" id="primary_color" name="primary_color" value="<%= settings.primary_color || '#d4af37' %>" style="width:100%;height:40px;padding:2px;cursor:pointer">
      </div>
      <div class="form-group">
        <label>Sekundärfarbe (Hover, Akzente)</label>
        <input type="color" id="secondary_color" name="secondary_color" value="<%= settings.secondary_color || '#f5d67b' %>" style="width:100%;height:40px;padding:2px;cursor:pointer">
      </div>
      <div class="form-group">
        <label>Akzentfarbe (Schatten, Rahmen)</label>
        <input type="color" id="accent_color" name="accent_color" value="<%= settings.accent_color || '#9c7c1a' %>" style="width:100%;height:40px;padding:2px;cursor:pointer">
      </div>
      <div class="form-group">
        <label>Header-Hintergrund (leer = Standard)</label>
        <div style="display:flex;gap:8px;align-items:center">
          <input type="color" id="header_bg_picker" value="<%= settings.header_bg || '#0a0a0a' %>" style="width:60px;height:40px;padding:2px;cursor:pointer">
          <input type="text" id="header_bg" name="header_bg" value="<%= settings.header_bg || '' %>" placeholder="z.B. #0a0a0a oder leer" style="flex:1">
          <button type="button" class="btn btn-small btn-secondary" onclick="document.getElementById('header_bg').value=''">Standard</button>
        </div>
      </div>
      <div class="form-group">
        <label>Werbebanner-Stil (Startseite oben)</label>
        <select name="hero_theme" id="hero_theme">
          <option value="black-gold" <%= settings.hero_theme !== 'banner' ? 'selected' : '' %>>Schwarz & Gold (edel)</option>
          <option value="banner" <%= settings.hero_theme === 'banner' ? 'selected' : '' %>>Banner-Bild (Foto)</option>
        </select>
      </div>
      <div class="form-group">
        <label>Schriftart</label>
        <select name="font_family">
          <option value="Inter" <%= settings.font_family === 'Inter' || !settings.font_family ? 'selected' : '' %>>Inter (Modern)</option>
          <option value="Playfair Display" <%= settings.font_family === 'Playfair Display' ? 'selected' : '' %>>Playfair Display (Elegant)</option>
          <option value="Josefin Sans" <%= settings.font_family === 'Josefin Sans' ? 'selected' : '' %>>Josefin Sans (Rund)</option>
          <option value="Lato" <%= settings.font_family === 'Lato' ? 'selected' : '' %>>Lato (Klassisch)</option>
        </select>
      </div>
      <div class="form-group">
        <label>Logo URL (optional)</label>
        <input type="text" name="logo_url" value="<%= settings.logo_url || '' %>" placeholder="https://example.com/logo.png">
      </div>
    </div>
    <div style="margin-top:16px">
      <label style="font-size:13px;color:#6b6b6b;font-weight:500">✨ Ein Klick – keine Farbcodes nötig:</label>
      <div style="margin-top:8px">
        <button type="button" class="btn btn-primary btn-lg" style="background:linear-gradient(135deg,#f5d67b,#d4af37 55%,#9c7c1a);color:#0a0a0a;border:none;font-weight:700" onclick="applyLuxus()">✨ Luxus Schwarz-Gold (empfohlen)</button>
      </div>
      <label style="font-size:13px;color:#6b6b6b;font-weight:500;margin-top:14px;display:block">Oder Farbe antippen:</label>
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;align-items:center">
        <button type="button" title="Gold klassisch" onclick="setPrimary('#d4af37')" style="width:38px;height:38px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 1px #ccc;background:#d4af37;cursor:pointer"></button>
        <button type="button" title="Gold hell" onclick="setPrimary('#ffd700')" style="width:38px;height:38px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 1px #ccc;background:#ffd700;cursor:pointer"></button>
        <button type="button" title="Gold dunkel" onclick="setPrimary('#b8860b')" style="width:38px;height:38px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 1px #ccc;background:#b8860b;cursor:pointer"></button>
        <button type="button" title="Bronze" onclick="setPrimary('#c9a227')" style="width:38px;height:38px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 1px #ccc;background:#c9a227;cursor:pointer"></button>
        <button type="button" title="Rot" onclick="applyPreset('#eb0029','#ff4d4d','#b8001f')" style="width:38px;height:38px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 1px #ccc;background:#eb0029;cursor:pointer"></button>
        <button type="button" title="Grün" onclick="applyPreset('#2d8a4e','#7bc496','#1d5c34')" style="width:38px;height:38px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 1px #ccc;background:#2d8a4e;cursor:pointer"></button>
        <button type="button" title="Blau" onclick="applyPreset('#2563eb','#93b4fd','#1e40af')" style="width:38px;height:38px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 1px #ccc;background:#2563eb;cursor:pointer"></button>
        <button type="button" title="Lila" onclick="applyPreset('#7c3aed','#c4b5fd','#5b21b6')" style="width:38px;height:38px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 1px #ccc;background:#7c3aed;cursor:pointer"></button>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px">
        <button type="button" class="btn btn-small" style="background:#0a0a0a;color:#d4af37;border:1px solid #d4af37" onclick="applyPreset('#d4af37','#f5d67b','#9c7c1a')">⬛ Schwarz-Gold</button>
        <button type="button" class="btn btn-small" style="background:#eb0029;color:#fff" onclick="applyPreset('#eb0029','#ff4d4d','#b8001f')">🟥 Rot</button>
        <button type="button" class="btn btn-small" style="background:#2d8a4e;color:#fff" onclick="applyPreset('#2d8a4e','#7bc496','#1d5c34')">🟩 Grün</button>
        <button type="button" class="btn btn-small" style="background:#2563eb;color:#fff" onclick="applyPreset('#2563eb','#93b4fd','#1e40af')">🟦 Blau</button>
        <button type="button" class="btn btn-small" style="background:#7c3aed;color:#fff" onclick="applyPreset('#7c3aed','#c4b5fd','#5b21b6')">🟪 Lila</button>
      </div>
    </div>
  </div>

<script>
function setPrimary(hex) {
  document.getElementById('primary_color').value = hex;
}
function applyLuxus() {
  applyPreset('#d4af37','#f5d67b','#9c7c1a');
  document.getElementById('header_bg').value = '#0a0a0a';
  document.getElementById('header_bg_picker').value = '#0a0a0a';
  document.getElementById('hero_theme').value = 'black-gold';
}

<script>
function applyPreset(primary, secondary, accent) {
  document.getElementById('primary_color').value = primary;
  document.getElementById('secondary_color').value = secondary;
  document.getElementById('accent_color').value = accent;
}
document.getElementById('header_bg_picker').addEventListener('input', function() {
  document.getElementById('header_bg').value = this.value;
});
</script>

  <button type="submit" class="btn btn-primary btn-lg">Einstellungen speichern</button>
</form>

<!-- Hero Slider Section (inline CRUD) -->
<div class="settings-card" style="margin-top:30px">
  <div class="section-header-row">
    <h3><i class="fas fa-images"></i> Hero Slider</h3>
    <button class="btn btn-primary" onclick="document.getElementById('newSlideForm').style.display='block'">+ Neuer Slide</button>
  </div>

  <!-- New Slide Form -->
  <div id="newSlideForm" style="display:none;background:#f8f9fa;padding:20px;border-radius:8px;margin-bottom:20px">
    <h4>Neuen Slide erstellen</h4>
    <form method="POST" action="/admin/einstellungen/hero-slides" enctype="multipart/form-data">
      <div class="form-grid">
        <div class="form-group"><label>Zeile 1</label><input name="line1" value="1 GROSSE"></div>
        <div class="form-group"><label>Zeile 2</label><input name="line2" value="PIZZA"></div>
        <div class="form-group"><label>Zeile 3</label><input name="line3" value="+ 4 GETRÄNKE"></div>
      </div>
      <div class="form-grid">
        <div class="form-group"><label>Preis (z.B. 10,99)</label><input name="preis1" value="19,99" placeholder="19,99"></div>
        <div class="form-group"><label>Preis-Label</label><input name="preis1_tag" value="ABHOLUNG"></div>
        <div class="form-group"><label>2. Preis (optional, leer = keiner)</label><input name="preis2" value="21,99" placeholder="leer lassen für nur 1 Preis"></div>
        <div class="form-group"><label>2. Preis-Label</label><input name="preis2_tag" value="LIEFERUNG"></div>
      </div>
      <div class="form-group"><label>Beschreibung</label><textarea name="description" rows="2" style="width:100%">Bestellen Sie eine große 3-Belag-Pizza...</textarea></div>
      <div class="form-grid">
        <div class="form-group"><label>Button Text</label><input name="button_text" value="JETZT BESTELLEN"></div>
        <div class="form-group"><label>Button Ziel</label><select name="button_link" style="width:100%;padding:8px">
          <% (typeof dealLinks !== 'undefined' ? dealLinks : []).forEach(function(dl) { %>
          <option value="<%= dl.value %>" <%= dl.value === '/speisekarte' ? 'selected' : '' %>><%= dl.label %></option>
          <% }); %>
        </select></div>
        <div class="form-group"><label>Sortierung</label><input type="number" name="sort_order" value="0"></div>
      </div>
      <div class="form-grid">
        <div class="form-group"><label>Hintergrundbild</label><input type="file" name="bg_image_file" accept="image/*"><br><small>Leer = Standardbild</small></div>
        <div class="form-group"><label>Hauptbild</label><input type="file" name="main_image_file" accept="image/*"><br><small>Leer = Standardbild</small></div>
        <div class="form-group"><label>Getränk (oben links)</label><input type="file" name="drink_tl_file" accept="image/*"><br><small>Leer = keins</small></div>
        <div class="form-group"><label>Getränk (oben rechts)</label><input type="file" name="drink_tr_file" accept="image/*"><br><small>Leer = keins</small></div>
        <div class="form-group"><label>Getränk (unten rechts)</label><input type="file" name="drink_br_file" accept="image/*"><br><small>Leer = keins</small></div>
      </div>
      <button type="submit" class="btn btn-primary">Erstellen</button>
      <button type="button" class="btn btn-secondary" onclick="document.getElementById('newSlideForm').style.display='none'">Abbrechen</button>
    </form>
  </div>

  <!-- Slides List -->
  <% if (!slides || slides.length === 0) { %>
  <p>Keine Slides vorhanden.</p>
  <% } else { %>
  <table class="table">
    <thead><tr><th>#</th><th>Zeilen</th><th>Preise</th><th>Hintergrund</th><th>Aktiv</th><th>Aktionen</th></tr></thead>
    <tbody>
      <% slides.forEach(function(s) { %>
      <tr>
        <td><%= s.sort_order %></td>
        <td><%= s.line1 || '' %> / <%= s.line2 || '' %></td>
        <td><%= s.price1 || '' %><%= s.price1_cents || '' %> <%= s.price1_tag || '' %></td>
        <td><img src="<%= s.bg_image || '/images/revolution/6cbea-bg1.jpg' %>" style="width:80px;height:45px;object-fit:cover;border-radius:4px"></td>
        <td><%= s.active ? '✓' : '✗' %></td>
        <td>
          <button class="btn btn-small btn-secondary" onclick="editSlide(<%= s.id %>)">Bearbeiten</button>
          <form method="POST" action="/admin/einstellungen/hero-slides/loeschen/<%= s.id %>" style="display:inline" onsubmit="return confirm('Wirklich löschen?')">
            <button class="btn btn-small btn-danger">Löschen</button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>
</div>

<!-- Edit Forms (hidden) -->
<% slides.forEach(function(s) { %>
<div id="editForm<%= s.id %>" style="display:none;background:#f8f9fa;padding:20px;border-radius:8px;margin-bottom:20px" class="settings-card">
  <h4>Slide bearbeiten #<%= s.id %></h4>
  <form method="POST" action="/admin/einstellungen/hero-slides/bearbeiten/<%= s.id %>" enctype="multipart/form-data">
    <div class="form-grid">
      <div class="form-group"><label>Zeile 1</label><input name="line1" value="<%= s.line1 || '' %>"></div>
      <div class="form-group"><label>Zeile 2</label><input name="line2" value="<%= s.line2 || '' %>"></div>
      <div class="form-group"><label>Zeile 3</label><input name="line3" value="<%= s.line3 || '' %>"></div>
    </div>
    <div class="form-grid">
      <div class="form-group"><label>Preis (z.B. 10,99)</label><input name="preis1" value="<%= (s.price1 || '') + (/^([,.]\d+)?€?$/.test(s.price1_cents || '') ? (s.price1_cents || '') : '') %>"></div>
      <div class="form-group"><label>Preis-Label</label><input name="preis1_tag" value="<%= s.price1_tag || '' %>"></div>
      <div class="form-group"><label>2. Preis (optional, leer = keiner)</label><input name="preis2" value="<%= (s.price2 || '') + (/^([,.]\d+)?€?$/.test(s.price2_cents || '') ? (s.price2_cents || '') : '') %>"></div>
      <div class="form-group"><label>2. Preis-Label</label><input name="preis2_tag" value="<%= s.price2_tag || '' %>"></div>
    </div>
    <div class="form-group"><label>Beschreibung</label><textarea name="description" rows="2" style="width:100%"><%= s.description || '' %></textarea></div>
    <div class="form-grid">
      <div class="form-group"><label>Button Text</label><input name="button_text" value="<%= s.button_text || 'JETZT BESTELLEN' %>"></div>
      <div class="form-group"><label>Button Ziel</label><select name="button_link" style="width:100%;padding:8px">
        <% (typeof dealLinks !== 'undefined' ? dealLinks : []).forEach(function(dl) { %>
        <option value="<%= dl.value %>" <%= (s.button_link || '') === dl.value ? 'selected' : '' %>><%= dl.label %></option>
        <% }); %>
        <% if ((s.button_link || '') && !(typeof dealLinks !== 'undefined' ? dealLinks : []).some(function(dl) { return dl.value === s.button_link; })) { %>
        <option value="<%= s.button_link %>" selected>Beibehalten: <%= s.button_link %></option>
        <% } %>
      </select></div>
      <div class="form-group"><label>Sortierung</label><input type="number" name="sort_order" value="<%= s.sort_order || 0 %>"></div>
      <div class="form-group"><label>Aktiv</label><input type="checkbox" name="active" value="1" <%= s.active ? 'checked' : '' %>></div>
    </div>
    <div class="form-grid">
      <div class="form-group"><label>Hintergrundbild</label><% if (s.bg_image && !String(s.bg_image).startsWith('data:')) { %><img src="<%= s.bg_image %>" style="width:80px;height:45px;object-fit:cover;border-radius:4px"><br><% } %><input type="file" name="bg_image_file" accept="image/*"><br><small>Leer = behalten · </small><label><input type="checkbox" name="remove_bg_image" value="1"> Bild entfernen</label></div>
      <div class="form-group"><label>Hauptbild</label><% if (s.main_image && !String(s.main_image).startsWith('data:')) { %><img src="<%= s.main_image %>" style="width:80px;height:45px;object-fit:cover;border-radius:4px"><br><% } %><input type="file" name="main_image_file" accept="image/*"><br><small>Leer = behalten · </small><label><input type="checkbox" name="remove_main_image" value="1"> Bild entfernen</label></div>
      <div class="form-group"><label>Getränk (oben links)</label><input type="file" name="drink_tl_file" accept="image/*"><br><small>Leer = behalten · </small><label><input type="checkbox" name="remove_drink_tl" value="1"> Bild entfernen</label></div>
      <div class="form-group"><label>Getränk (oben rechts)</label><input type="file" name="drink_tr_file" accept="image/*"><br><small>Leer = behalten · </small><label><input type="checkbox" name="remove_drink_tr" value="1"> Bild entfernen</label></div>
      <div class="form-group"><label>Getränk (unten rechts)</label><input type="file" name="drink_br_file" accept="image/*"><br><small>Leer = behalten · </small><label><input type="checkbox" name="remove_drink_br" value="1"> Bild entfernen</label></div>
    </div>
    <button type="submit" class="btn btn-primary">Speichern</button>
    <button type="button" class="btn btn-secondary" onclick="editSlide(<%= s.id %>)">Abbrechen</button>
  </form>
</div>
<% }); %>

<script>
function editSlide(id) {
  var form = document.getElementById('editForm' + id);
  form.style.display = form.style.display === 'none' ? 'block' : 'none';
}
</script>
