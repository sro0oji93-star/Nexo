<%- include('layout') %>
<div class="dashboard-stats">
  <div class="stat-card">
    <div class="stat-icon" style="background: rgba(212,175,55, 0.1);"><i class="fas fa-utensils" style="color: #d4af37;"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= stats.products %></span>
      <span class="stat-label">Produkte</span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background: rgba(45, 138, 78, 0.1);"><i class="fas fa-tags" style="color: #2d8a4e;"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= stats.categories %></span>
      <span class="stat-label">Kategorien</span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background: rgba(66, 153, 225, 0.1);"><i class="fas fa-clipboard-list" style="color: #4299e1;"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= stats.orders %></span>
      <span class="stat-label">Bestellungen</span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background: rgba(237, 137, 54, 0.1);"><i class="fas fa-clock" style="color: #ed8936;"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= stats.pending %></span>
      <span class="stat-label">Offene Bestellungen</span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background: rgba(212,175,55, 0.1);"><i class="fas fa-euro-sign" style="color: #d4af37;"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= parseFloat(stats.revenue).toFixed(2) %> €</span>
      <span class="stat-label">Gesamtumsatz</span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background: rgba(237, 137, 54, 0.1);"><i class="fas fa-envelope" style="color: #ed8936;"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= stats.unreadMessages %></span>
      <span class="stat-label">Ungelesene Nachrichten</span>
    </div>
  </div>
</div>

<div class="dashboard-section">
  <div class="section-header-row">
    <h2><i class="fas fa-clock"></i> Letzte Bestellungen</h2>
    <a href="/admin/bestellungen" class="btn btn-sm btn-outline">Alle anzeigen</a>
  </div>
  <div class="table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Bestellnr.</th>
          <th>Kunde</th>
          <th>Betrag</th>
          <th>Status</th>
          <th>Datum</th>
        </tr>
      </thead>
      <tbody>
        <% stats.recentOrders.forEach(function(o) { %>
        <tr>
          <td><a href="/admin/bestellungen/<%= o.id %>"><%= o.order_number %></a></td>
          <td><%= o.customer_name %></td>
          <td><%= parseFloat(o.total).toFixed(2) %> €</td>
          <td><span class="status-badge status-<%= o.order_status %>"><%= o.order_status === 'neu' ? 'Neu' : (o.order_status === 'in_bearbeitung' ? 'In Bearbeitung' : (o.order_status === 'unterwegs' ? 'Unterwegs' : (o.order_status === 'geliefert' ? 'Geliefert' : (o.order_status === 'wartet_auf_zahlung' ? 'Wartet auf Zahlung' : 'Storniert')))) %></span></td>
          <td><%= new Date(o.created_at).toLocaleDateString('de-DE') %></td>
        </tr>
<% }); %>
      </tbody>
    </table>
  </div>
</div>
<%- include('footer') %>
</div>
