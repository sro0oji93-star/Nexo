<%- include('layout') %>
<div class="section-header-row">
  <h2><i class="fas fa-clipboard-list"></i> Bestellungen</h2>
  <form method="GET" action="/admin/bestellungen" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
    <input type="hidden" name="status" value="<%= currentStatus %>">
    <a href="/admin/bestellungen?status=<%= currentStatus %>&datum=<%= new Date(new Date(datum).getTime() - 86400000).toISOString().slice(0,10) %>" class="btn btn-sm btn-outline">‹</a>
    <input type="date" name="datum" value="<%= datum %>" onchange="this.form.submit()" style="padding:8px 12px;border-radius:8px;border:1px solid #e8e4de;font-size:13px">
    <a href="/admin/bestellungen?status=<%= currentStatus %>&datum=<%= new Date(new Date(datum).getTime() + 86400000).toISOString().slice(0,10) %>" class="btn btn-sm btn-outline">›</a>
    <span class="badge"><%= dayCount %> Bestellungen · <%= parseFloat(dayRevenue).toFixed(2) %> €</span>
  </form>
  <div class="filter-group">
    <a href="/admin/bestellungen?status=alle&datum=<%= datum %>" class="btn btn-sm <%= currentStatus === 'alle' ? 'btn-primary' : 'btn-outline' %>">Alle</a>
    <a href="/admin/bestellungen?status=neu&datum=<%= datum %>" class="btn btn-sm <%= currentStatus === 'neu' ? 'btn-primary' : 'btn-outline' %>">Neu</a>
    <a href="/admin/bestellungen?status=in_bearbeitung&datum=<%= datum %>" class="btn btn-sm <%= currentStatus === 'in_bearbeitung' ? 'btn-primary' : 'btn-outline' %>">In Bearbeitung</a>
    <a href="/admin/bestellungen?status=unterwegs&datum=<%= datum %>" class="btn btn-sm <%= currentStatus === 'unterwegs' ? 'btn-primary' : 'btn-outline' %>">Unterwegs</a>
    <a href="/admin/bestellungen?status=geliefert&datum=<%= datum %>" class="btn btn-sm <%= currentStatus === 'geliefert' ? 'btn-primary' : 'btn-outline' %>">Geliefert</a>
  </div>
</div>

<div class="table-container">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Bestellnr.</th>
        <th>Kunde</th>
        <th>E-Mail</th>
        <th>Betrag</th>
        <th>Zahlung</th>
        <th>Status</th>
        <th>Datum</th>
        <th>Aktion</th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach(function(o) { %>
      <tr>
        <td><a href="/admin/bestellungen/<%= o.id %>"><%= o.order_number %></a><% if (o.wish_display) { %><br><span class="badge" style="background:#e8f5e9;color:#15803d;border:1px solid #15803d">Wunsch: <%= o.wish_display %></span><% } %></td>
        <td><%= o.customer_name %></td>
        <td><%= o.customer_email %></td>
        <td><strong><%= parseFloat(o.total).toFixed(2) %> €</strong></td>
        <td><span class="badge badge-payment"><%= o.payment_method === 'bar' ? 'Bar' : (o.payment_method === 'karte' ? 'Karte' : 'Online') %></span></td>
        <td>
          <form method="POST" action="/admin/bestellungen/status/<%= o.id %>" class="status-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <select name="status" onchange="this.form.submit()">
              <option value="wartet_auf_zahlung" <%= o.order_status === 'wartet_auf_zahlung' ? 'selected' : '' %>>Wartet auf Zahlung</option>
              <option value="neu" <%= o.order_status === 'neu' ? 'selected' : '' %>>Neu</option>
              <option value="in_bearbeitung" <%= o.order_status === 'in_bearbeitung' ? 'selected' : '' %>>In Bearbeitung</option>
              <option value="unterwegs" <%= o.order_status === 'unterwegs' ? 'selected' : '' %>>Unterwegs</option>
              <option value="geliefert" <%= o.order_status === 'geliefert' ? 'selected' : '' %>>Geliefert</option>
              <option value="storniert" <%= o.order_status === 'storniert' ? 'selected' : '' %>>Storniert</option>
            </select>
          </form>
        </td>
        <td><%= new Date(o.created_at).toLocaleDateString('de-DE') + ' ' + new Date(o.created_at).toLocaleTimeString('de-DE', {hour:'2-digit', minute:'2-digit'}) %></td>
        <td>
          <a href="/admin/bestellungen/<%= o.id %>" class="btn btn-sm btn-outline"><i class="fas fa-eye"></i></a>
          <a href="/admin/bestellungen/<%= o.id %>/bon?autoprint=1" target="_blank" class="btn btn-sm btn-outline" title="Bon drucken (TM-T88V)"><i class="fas fa-print"></i></a>
          <form method="POST" action="/admin/bestellungen/loeschen/<%= o.id %>" style="display:inline" onsubmit="return confirm('Bestellung wirklich löschen?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm btn-danger" style="padding:4px 8px"><i class="fas fa-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }); %>
      <% if (orders.length === 0) { %>
      <tr><td colspan="8" class="empty-state">Keine Bestellungen gefunden</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('footer') %>
