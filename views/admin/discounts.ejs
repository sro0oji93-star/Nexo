<%- include('layout') %>
<div class="section-header-row">
  <h2><i class="fas fa-percent"></i> Rabattcodes verwalten</h2>
  <div style="display:flex;gap:8px">
    <button class="btn btn-outline" onclick="openModal('bulkDiscountModal')"><i class="fas fa-layer-group"></i> Bulk erstellen</button>
    <button class="btn btn-primary" onclick="openModal('addDiscountModal')"><i class="fas fa-plus"></i> Neuer Rabatt</button>
  </div>
</div>

<% if (typeof bulkError !== 'undefined' && bulkError) { %>
<div class="alert alert-danger" style="background:#f8d7da;border:1px solid #dc3545;color:#721c24;padding:12px 16px;border-radius:8px;margin-bottom:16px"><%= bulkError %></div>
<% } %>
<% if (typeof newCodes !== 'undefined' && newCodes && newCodes.length) { %>
<div class="table-container" style="margin-bottom:16px">
  <h3 style="margin:0 0 8px"><i class="fas fa-check-circle"></i> <%= newCodes.length %> Codes ausgewählt <a href="/admin/rabatte?batch=clear" style="font-size:12px;font-weight:400">Auswahl schließen</a></h3>
  <form id="bulkOutputForm" style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-start">
    <div style="flex:1;min-width:240px;max-height:220px;overflow-y:auto;border:1px solid #e8e4de;border-radius:8px;padding:8px 12px">
      <% newCodes.forEach(function(cd, i) { %>
      <label style="display:block;padding:4px 0;font-size:14px;cursor:pointer"><input type="checkbox" name="codes" value="<%= cd %>" checked> <strong><%= cd %></strong></label>
      <% }); %>
    </div>
    <div style="display:flex;flex-direction:column;gap:8px">
      <button type="button" class="btn btn-outline" onclick="bulkOutput('drucken')">🖨️ Drucken (Auswahl)</button>
      <button type="button" class="btn btn-outline" onclick="bulkOutput('drucken', true)">🖨️ Alle neuen Codes drucken</button>
      <button type="button" class="btn btn-outline" onclick="bulkOutput('pdf')">📄 PDF herunterladen</button>
    </div>
  </form>
  <script>
  function bulkOutput(kind, all) {
    var boxes = document.querySelectorAll('#bulkOutputForm input[name="codes"]');
    var sel = [];
    boxes.forEach(function(c) { if (all || c.checked) sel.push(c.value); });
    if (!sel.length) { alert('Bitte mindestens einen Code auswählen.'); return; }
    var url = kind === 'pdf' ? '/admin/rabatte/pdf?codes=' : '/admin/rabatte/drucken?codes=';
    if (kind !== 'pdf') url += '&autoprint=1';
    window.open(url + sel.map(encodeURIComponent).join(','), '_blank');
  }
  </script>
</div>
<% } %>

<div class="table-container">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Code</th>
        <th>Typ</th>
        <th>Wert</th>
        <th>Mindestbestellwert</th>
        <th>Genutzt</th>
        <th>Gültig bis</th>
        <th>Status</th>
        <th>Aktion</th>
      </tr>
    </thead>
    <tbody>
      <% discounts.forEach(function(d) { %>
      <tr>
        <td><strong><%= d.code %></strong></td>
        <td><%= d.type === 'prozent' ? 'Prozent' : 'Festbetrag' %></td>
        <td><%= d.type === 'prozent' ? d.value + '%' : d.value.toFixed(2) + ' €' %></td>
        <td><%= parseFloat(d.min_order).toFixed(2) %> €</td>
        <td><%= d.used_count %><% if (d.usage_limit > 0) { %> / <%= d.usage_limit %><% } %></td>
        <td><%= d.expires_at ? new Date(d.expires_at).toLocaleDateString('de-DE') : '∞' %></td>
        <td><span class="status-badge <%= d.active ? 'status-verfuegbar' : 'status-ausverkauft' %>"><%= d.active ? 'Aktiv' : 'Inaktiv' %></span></td>
        <td>
          <a href="/admin/rabatte/drucken?codes=<%= d.code %>&autoprint=1" target="_blank" class="btn btn-sm btn-outline" title="Diesen Code drucken"><i class="fas fa-print"></i></a>
          <form method="POST" action="/admin/rabatte/loeschen/<%= d.id %>" style="display:inline" onsubmit="return confirm('Wirklich löschen?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="modal" id="addDiscountModal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Neuer Rabattcode</h3>
      <button class="modal-close" onclick="closeModal('addDiscountModal')">&times;</button>
    </div>
    <form method="POST" action="/admin/rabatte">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="form-group">
          <label>Code *</label>
          <input type="text" name="code" required placeholder="z.B. SOMMER10">
        </div>
        <div class="form-group">
          <label>Typ</label>
          <select name="type">
            <option value="prozent">Prozent (%)</option>
            <option value="fest">Festbetrag (€)</option>
          </select>
        </div>
        <div class="form-group">
          <label>Wert *</label>
          <input type="number" step="0.01" name="value" required placeholder="10">
        </div>
        <div class="form-group">
          <label>Mindestbestellwert</label>
          <input type="number" step="0.01" name="min_order" value="0">
        </div>
        <div class="form-group">
          <label>Nutzungslimit (0 = unbegrenzt)</label>
          <input type="number" name="usage_limit" value="0">
        </div>
        <div class="form-group">
          <label>Gültig bis</label>
          <input type="date" name="expires_at">
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Speichern</button>
    </form>
  </div>
</div>

<div class="modal" id="bulkDiscountModal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Rabattcodes bulk erstellen</h3>
      <button class="modal-close" onclick="closeModal('bulkDiscountModal')">&times;</button>
    </div>
    <form method="POST" action="/admin/rabatte/bulk">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="form-group">
          <label>Anzahl Rabattcodes * (1–1000)</label>
          <input type="number" name="anzahl" min="1" max="1000" value="100" required>
        </div>
        <div class="form-group">
          <label>Prefix (optional)</label>
          <input type="text" name="prefix" placeholder="z.B. SOMMER" style="text-transform:uppercase">
        </div>
        <div class="form-group">
          <label>Typ</label>
          <select name="type">
            <option value="prozent">Prozent (%)</option>
            <option value="fest">Festbetrag (€)</option>
          </select>
        </div>
        <div class="form-group">
          <label>Wert *</label>
          <input type="number" step="0.01" name="value" required placeholder="10">
        </div>
        <div class="form-group">
          <label>Mindestbestellwert</label>
          <input type="number" step="0.01" name="min_order" value="0">
        </div>
        <div class="form-group">
          <label>Nutzungslimit je Code (0 = unbegrenzt)</label>
          <input type="number" name="usage_limit" value="0">
        </div>
        <div class="form-group">
          <label>Gültig bis</label>
          <input type="date" name="expires_at">
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Rabattcodes erstellen</button>
    </form>
  </div>
</div>
<%- include('footer') %>
