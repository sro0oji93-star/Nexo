<!-- Enhanced mobile nav: close on link click -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.mad-navigation a').forEach(function(link) {
    link.addEventListener('click', function() {
      var nav = document.querySelector('.mad-navigation--vertical-sm');
      var btn = document.querySelector('.mad-mobile-nav-btn');
      if (nav) nav.classList.remove('mad-opened');
      if (btn) btn.classList.remove('mad-opened');
    });
  });
});
</script>
