<% /* Bowls-Saucen – Locals: productId. 1× inklusive, jede weitere +0,80 €. Checkboxen (Mehrfachwahl). */ %>
<% var bowlSauceList = ['NEXO Haussoße', 'Knoblauchsoße', 'BBQ-Soße', 'American-Soße', 'Cheddar-Soße']; %>
<% /* Bowls-Extras – Festpreise, serverseitig in order-pricing.js geprüft (nur bowls). */ %>
<% var bowlExtra350 = ['Chicken', 'Rinderstreifen', 'Scampi [b]', 'Bacon [2,3]', 'Brokkoli', 'Paprika']; %>
<% var bowlExtra100 = ['Mais', 'Karotten', 'Sesam [k]', 'Cheddar [g]', 'Röstzwiebeln [a1]', 'Champignons', 'Zwiebeln', 'Käse']; %>
<div class="bowls-sauces" data-bowlsauces-for="<%= productId %>" style="margin-top:10px;border:1px dashed #e5c8ce;border-radius:10px;padding:10px 12px;background:#fffdf7">
  <details>
    <summary style="cursor:pointer;font-weight:700;font-size:13px;color:#232223">Sauce nach Wahl <span style="font-weight:400;color:#7a7879;font-size:12px">– 1× inklusive, jede weitere +0,80 €</span></summary>
    <div style="margin-top:8px;display:flex;flex-direction:column;gap:2px;max-height:220px;overflow-y:auto;padding-right:4px">
      <% bowlSauceList.forEach(function(nm) { %>
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;padding:4px 6px;border-radius:8px;border:1.5px solid transparent">
        <input type="checkbox" data-bowl-sauce="<%= nm %>" style="width:16px;height:16px;accent-color:#16a34a">
        <span style="flex:1;font-weight:600;color:#232223"><%= nm %></span>
        <span class="sauce-tick" style="display:none;color:#16a34a;font-weight:900;font-size:14px">✓</span>
      </label>
      <% }); %>
    </div>
  </details>
</div>
<div class="bowls-sauces" data-bowlextras-for="<%= productId %>" style="margin-top:10px;border:1px dashed #e5c8ce;border-radius:10px;padding:10px 12px;background:#fffdf7">
  <details>
    <summary style="cursor:pointer;font-weight:700;font-size:13px;color:#232223">Extra Zutaten <span style="font-weight:400;color:#7a7879;font-size:12px">– je +3,50 €</span></summary>
    <div style="margin-top:8px;display:flex;flex-direction:column;gap:2px;max-height:220px;overflow-y:auto;padding-right:4px">
      <% bowlExtra350.forEach(function(nm) { %>
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;padding:4px 6px;border-radius:8px;border:1.5px solid transparent">
        <input type="checkbox" data-bowl-extra="<%= nm %>" data-bowl-price="3.50" style="width:16px;height:16px;accent-color:#16a34a">
        <span style="flex:1;font-weight:600;color:#232223"><%= nm %></span>
        <span style="font-weight:700;color:#9c7c1a;font-size:12px">+3,50 €</span>
        <span class="sauce-tick" style="display:none;color:#16a34a;font-weight:900;font-size:14px">✓</span>
      </label>
      <% }); %>
    </div>
  </details>
  <details>
    <summary style="cursor:pointer;font-weight:700;font-size:13px;color:#232223">Weitere Extras <span style="font-weight:400;color:#7a7879;font-size:12px">– je +1,00 €</span></summary>
    <div style="margin-top:8px;display:flex;flex-direction:column;gap:2px;max-height:220px;overflow-y:auto;padding-right:4px">
      <% bowlExtra100.forEach(function(nm) { %>
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;padding:4px 6px;border-radius:8px;border:1.5px solid transparent">
        <input type="checkbox" data-bowl-extra="<%= nm %>" data-bowl-price="1.00" style="width:16px;height:16px;accent-color:#16a34a">
        <span style="flex:1;font-weight:600;color:#232223"><%= nm %></span>
        <span style="font-weight:700;color:#9c7c1a;font-size:12px">+1,00 €</span>
        <span class="sauce-tick" style="display:none;color:#16a34a;font-weight:900;font-size:14px">✓</span>
      </label>
      <% }); %>
    </div>
  </details>
</div>
