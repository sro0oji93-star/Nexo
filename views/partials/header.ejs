<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof settings !== 'undefined' && settings.site_description ? settings.site_description : 'Ammaya Restaurant' %>">
  <meta name="theme-color" content="#0a0a0a">
  <title><%= typeof title !== 'undefined' ? title : 'Ammaya' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css?family=Material+Icons%7CMaterial+Icons+Outlined%7CMaterial+Icons+Two+Tone%7CMaterial+Icons+Round%7CMaterial+Icons+Sharp" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/yummi-full.css">
  <link rel="stylesheet" href="/css/owl.carousel.min.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/style.css?v=20260912e">
  <link rel="stylesheet" href="/css/black-gold.css">
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Ammaya' %>">
  <meta property="og:description" content="<%= typeof settings !== 'undefined' && settings.site_description ? settings.site_description : 'Ammaya Restaurant' %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
<style>
:root {
  --primary: <%= typeof settings !== 'undefined' && settings.primary_color ? settings.primary_color : '#d4af37' %>;
  --secondary: <%= typeof settings !== 'undefined' && settings.secondary_color ? settings.secondary_color : '#f5d67b' %>;
  --accent: <%= typeof settings !== 'undefined' && settings.accent_color ? settings.accent_color : '#9c7c1a' %>;
  --font-family: '<%= typeof settings !== 'undefined' && settings.font_family ? settings.font_family : 'Inter' %>', sans-serif;
}
<% if (typeof settings !== 'undefined' && settings.header_bg) { %>
#mad-header, .mad-header-section--sticky-xl { background: <%= settings.header_bg %> !important; }
<% } %>
@media (max-width: 767px) {
  .mad-mobile-nav-btn { display:none !important; }
  .mad-header-items { display:flex; align-items:center; justify-content:space-between; flex-wrap:nowrap; gap:4px; }
  .mad-actions { gap:4px !important; }
  .mad-actions .mad-item a { padding:6px !important; }
  .mad-header-item:last-child { margin-left:auto; }
  .mad-our-info.type-2 { display:none !important; }
  .mad-logo-text { font-size:20px !important; }
  .mad-logo-img { height:42px !important;max-width:210px !important; }
}
</style>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>"<%= typeof activeMenu !== 'undefined' ? ' data-active="' + activeMenu + '"' : '' %>>

<div id="mad-page-wrapper" class="mad-page-wrapper">

<!--================ Header ================-->
<header id="mad-header" class="mad-header<%= typeof bodyClass !== 'undefined' && bodyClass === 'homepage' ? ' mad-header--transparent' : '' %>">
  <div class="mad-pre-header">
    <div class="mad-our-info">
      <div class="mad-info"><i class="material-icons-outlined">location_on</i> <span><%= typeof settings !== 'undefined' && settings.address ? settings.address : 'Pieperstraße 8, 21357 Bardowick' %></span></div>
      <div class="mad-info"><i class="material-icons">access_time</i> <span><%= typeof settings !== 'undefined' && settings.opening_hours ? settings.opening_hours : 'Mo–So: 11:30 – 22:30' %></span></div>
    </div>
    <div class="mad-quick-links">
      <a href="/speisekarte">Speisekarte</a>
      <span>|</span>
      <a href="/kontakt">Kontakt</a>
      <span>|</span>
      <a href="/warenkorb">Warenkorb</a>
    </div>
  </div>
  <div class="mad-header-section--sticky-xl">
    <div class="mad-header-items">
      <div class="mad-header-item">
        <a href="/" class="mad-logo"><% if (typeof settings !== 'undefined' && settings.logo_url) { %><img src="<%= settings.logo_url %>" alt="<%= settings.site_name || 'Logo' %>" class="mad-logo-img" style="height:58px;width:auto;max-width:300px;object-fit:contain"><% } else { %><span class="mad-logo-text"><%= typeof settings !== 'undefined' && settings.site_name ? settings.site_name : 'Ammaya' %></span><% } %></a>
      </div>
      <!--================ Navigation ================-->
      <nav class="mad-navigation-container">
        <ul class="mad-navigation mad-navigation--vertical-sm">
          <li class="menu-item<%= typeof bodyClass !== 'undefined' && bodyClass === 'homepage' ? ' current-menu-item' : '' %>"><a href="/">Start</a></li>
          <li class="menu-item<%= typeof activeMenu !== 'undefined' && activeMenu === 'speisekarte' ? ' current-menu-item' : '' %>"><a href="/speisekarte">Speisekarte</a></li>
          <li class="menu-item<%= typeof activeMenu !== 'undefined' && activeMenu === 'kontakt' ? ' current-menu-item' : '' %>"><a href="/kontakt">Kontakt</a></li>
        </ul>
      </nav>
      <!--================ End of Navigation ================-->
      <button class="mad-mobile-nav-btn"></button>
      <div class="mad-header-item">
        <div class="mad-our-info type-2">
          <div class="mad-info">
            <i class="material-icons-outlined">call</i>
            <div class="mad-info-content">
              <span>Bestellhotline</span>
              <div class="mad-info-title"><%= typeof settings !== 'undefined' && settings.phone ? settings.phone : '+49 30 123456789' %></div>
            </div>
          </div>
        </div>
      </div>
      <div class="mad-header-item">
        <div class="mad-actions">
          <div class="mad-item">
            <a href="/warenkorb" class="mad-item-link cart-link-mad" id="cartLink">
              <i class="material-icons-outlined">shopping_cart</i>
              <span class="mad-cart-count" id="cartBadgeMad">0</span>
            </a>
          </div>
          <div class="mad-item">
            <a href="/speisekarte" class="btn btn-small"><span>Bestellen</span></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
<!--================ End of Header ================-->
