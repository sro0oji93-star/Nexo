<%- include('partials/header') %>

<div class="mad-breadcrumb">
  <div class="container">
    <nav class="mad-breadcrumb-path"><span><a href="/">Home</a></span> / <span><a href="/speisekarte">Speisekarte</a></span> / <span><%= product.category_name %></span> / <span><%= product.name %></span>
    </nav>
  </div>
</div>

<div class="mad-content">
  <div class="container">
    <div class="content-element-13">
      <div class="mad-product mad-product-single">
        <div class="row">
          <div class="col-xl-6">
            <div class="image-preview-container">
              <div class="image-preview">
                <a href="<%= product.image || '/images/384x384_img1.jpg' %>" data-fancybox="group">
                  <img id="zoom-image" src="<%= product.image || '/images/384x384_img1.jpg' %>" alt="<%= product.name %>">
                </a>
              </div>
            </div>
          </div>
          <div class="col-xl-6">
            <h2 class="mad-product-title"><%= product.name %><% if (product.is_featured) { %> <span style="display:inline-block;font-size:12px;font-weight:700;color:#0a0a0a;background:linear-gradient(135deg,#f5d67b,#d4af37);border-radius:50px;padding:3px 12px;vertical-align:middle">⭐ Empfohlen</span><% } %></h2>
            <p><%= product.description %></p>
            <div class="mad-product-calc">
              <% if (product.old_price) { %>
                <span class="mad-product-price" style="text-decoration:line-through;color:#999;font-size:16px;margin-right:8px"><%= product.old_price.toFixed(2) %> €</span>
              <% } %>
              <% if (product.sizes) { var sizeData = JSON.parse(product.sizes); var minPrice = Math.min.apply(null, sizeData.map(function(s){return s.price})); var maxPrice = Math.max.apply(null, sizeData.map(function(s){return s.price})); %>
              <span class="mad-product-price" id="detailPrice"><%= product.category_name === 'Burger' ? ('ab ' + product.price.toFixed(2)) : ((minPrice === maxPrice ? '' : 'ab ') + minPrice.toFixed(2)) %> €</span>
              <% } else { %>
              <span class="mad-product-price" id="detailPrice"><%= product.price.toFixed(2) %> €</span>
              <% } %>
            </div>
            <% if (!product.is_available) { %>
            <div style="margin:16px 0;padding:14px 18px;border-radius:10px;background:rgba(220,53,53,.08);border:1px solid rgba(220,53,53,.25);color:#dc3545;font-weight:700">Ausverkauft – derzeit nicht bestellbar.</div>
            <% } else { %>
            <% if (product.sizes) { var sizeData = JSON.parse(product.sizes); %>
            <div class="form-control content-element-6">
              <div class="content-element-2">
                <% if (product.category_name === 'Croque' || product.category_name === 'Salat' || product.category_name === 'Rings') { %>
                <%- include('partials/croque-sauces', { productId: product.id, sizeData: sizeData, radioName: 'detailSize' }) %>
                <% } else if (product.category_name === 'Schnitzel' || product.category_name === 'Bowls') { %>
                <%- include('partials/croque-sauces', { productId: product.id, sizeData: sizeData, radioName: 'detailSize', boxTitle: '1 Beilage nach Wahl' }) %>
                <% } else if (product.category_name === 'Burger') { %>
                <%- include('partials/burger-menue', { productId: product.id, productName: product.name, sizeData: sizeData, radioName: 'detailSize' }) %>
            <% } else if (['crepe-nutella','crepe-frucht','crepe-lotus','crepe-oreo','crepe-bueno','mini-pancakes','mini-waffel'].indexOf(product.slug) !== -1) { %>
            <div class="form-control content-element-6">
              <div class="content-element-2">
                <%- include('partials/choco-box', { productId: product.id }) %>
                <p class="mad-text-color-2 content-element">Anzahl:</p>
                <div class="btn-set big-btns">
                  <div class="quantity size-2">
                    <input type="text" id="qtyInput" value="1" readonly>
                    <button type="button" class="qty-plus"><i class="material-icons">add</i></button>
                    <button type="button" class="qty-minus"><i class="material-icons">remove</i></button>
                  </div>
                  <button class="btn btn-big btn-style-3 add-to-cart" data-id="<%= product.id %>" data-name="<%= product.name %>" data-price="<%= product.price %>" data-has-choco="1">
                    <i class="material-icons-outlined">shopping_cart</i><span>In den Warenkorb</span>
                  </button>
                </div>
              </div>
            </div>
            <% } else { %>
                <p class="mad-text-color-2 content-element">Größe wählen:</p>
                <div class="size-picker-detail" style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px">
                  <% sizeData.forEach(function(s) { %>
                  <label class="size-option-detail" style="cursor:pointer;padding:12px 20px;border:2px solid #3a3a41;border-radius:12px;font-size:15px;transition:all .25s ease;text-align:center;min-width:100px;background:#1d1d21;color:#f0ead8;box-shadow:0 2px 8px rgba(0,0,0,0.4);position:relative;overflow:hidden">
                    <input type="radio" name="detailSize" value="<%= s.price %>" data-label="<%= s.label %>" style="display:none" <%= sizeData.indexOf(s) === 0 ? 'checked' : '' %>>
                    <span style="display:block;font-weight:600;font-size:16px;margin-bottom:4px"><%= s.label %></span>
                    <span class="size-price" style="display:block;color:var(--primary);font-weight:700;font-size:15px"><%= s.price.toFixed(2) %> €</span>
                  </label>
                  <% }); %>
                </div>
                <% } %>
                <% if (product.category_name === 'Snacks') { %><%- include('partials/snacks-menue', { productId: product.id }) %><% } %>
                <% if (product.category_name === 'Bowls') { %><%- include('partials/bowls-sauces', { productId: product.id }) %><% } %>
                <% if (product.category_name === 'Pizza Brötchen') { %><%- include('partials/free-sauce', { productId: product.id }) %><% } %>
                <% if (['crepe-nutella','crepe-frucht','crepe-lotus','crepe-oreo','crepe-bueno','mini-pancakes','mini-waffel'].indexOf(product.slug) !== -1) { %><%- include('partials/choco-box', { productId: product.id }) %><% } %>
                <% if (isPizza) { %><%- include('partials/pizza-extras', { productId: product.id }) %><% } %>
                <p class="mad-text-color-2 content-element">Anzahl:</p>
                <div class="btn-set big-btns">
                  <div class="quantity size-2">
                    <input type="text" id="qtyInput" value="1" readonly>
                    <button type="button" class="qty-plus"><i class="material-icons">add</i></button>
                    <button type="button" class="qty-minus"><i class="material-icons">remove</i></button>
                  </div>
                  <button class="btn btn-big btn-style-3 add-to-cart" data-id="<%= product.id %>" data-name="<%= product.name %>" <%- product.category_name === 'Burger' ? 'data-price="' + product.price + '" data-has-menue="1"' : (product.category_name === 'Snacks' ? 'data-price="' + product.price + '" data-has-snacks-menue="1"' : (product.category_name === 'Pizza Brötchen' ? 'data-price="' + product.price + '" data-has-sauce="1"' : 'data-has-sizes="1"')) %>>
                    <i class="material-icons-outlined">shopping_cart</i><span>In den Warenkorb</span>
                  </button>
                </div>
              </div>
            </div>
            <% } else if (product.slug === 'nexo-mittag-deal') { %>
            <div class="form-control content-element-6">
              <div class="content-element-2">
                <%- include('partials/deal-choices', { productId: product.id, dealLists: typeof dealLists !== 'undefined' ? dealLists : null }) %>
                <p class="mad-text-color-2 content-element">Anzahl:</p>
                <div class="btn-set big-btns">
                  <div class="quantity size-2">
                    <input type="text" id="qtyInput" value="1" readonly>
                    <button type="button" class="qty-plus"><i class="material-icons">add</i></button>
                    <button type="button" class="qty-minus"><i class="material-icons">remove</i></button>
                  </div>
                  <button class="btn btn-big btn-style-3 add-to-cart" data-id="<%= product.id %>" data-name="<%= product.name %>" data-price="<%= product.price %>" data-has-deal="1" data-deal-slug="nexo-mittag-deal">
                    <i class="material-icons-outlined">shopping_cart</i><span>In den Warenkorb</span>
                  </button>
                </div>
              </div>
            </div>
            <% } else if (product.boxGroups) { %>
            <div class="form-control content-element-6">
              <div class="content-element-2">
                <%- include('partials/box-choices', { productId: product.id, boxSlug: product.slug, boxGroups: product.boxGroups }) %>
                <p class="mad-text-color-2 content-element">Anzahl:</p>
                <div class="btn-set big-btns">
                  <div class="quantity size-2">
                    <input type="text" id="qtyInput" value="1" readonly>
                    <button type="button" class="qty-plus"><i class="material-icons">add</i></button>
                    <button type="button" class="qty-minus"><i class="material-icons">remove</i></button>
                  </div>
                  <button class="btn btn-big btn-style-3 add-to-cart" data-id="<%= product.id %>" data-name="<%= product.name %>" data-price="<%= product.price %>" data-has-box="1" data-box-slug="<%= product.slug %>">
                    <i class="material-icons-outlined">shopping_cart</i><span>In den Warenkorb</span>
                  </button>
                </div>
              </div>
            </div>
            <% } else { %>
            <div class="form-control content-element-6">
              <div class="content-element-2">
                <p class="mad-text-color-2 content-element">Anzahl:</p>
                <div class="btn-set big-btns">
                  <div class="quantity size-2">
                    <input type="text" id="qtyInput" value="1" readonly>
                    <button type="button" class="qty-plus"><i class="material-icons">add</i></button>
                    <button type="button" class="qty-minus"><i class="material-icons">remove</i></button>
                  </div>
                  <% var detailDeal = null; if (product.slug === 'nexo-mittag-deal') { detailDeal = { from: 720, to: 900, hint: 'Nur 12:00–15:00 Uhr bestellbar' }; } else if (product.slug === 'nexo-night-deal') { detailDeal = { from: 1260, to: 1440, hint: 'Ab 21:00 Uhr bestellbar · nur Abholer' }; } %>
                  <button class="btn btn-big btn-style-3 add-to-cart" data-id="<%= product.id %>" data-name="<%= product.name %>" data-price="<%= product.price %>"<%- detailDeal ? ' data-deal-from="' + detailDeal.from + '" data-deal-to="' + detailDeal.to + '" data-deal-hint="' + detailDeal.hint + '"' : '' %><%- product.slug === 'nexo-night-deal' ? ' data-pickup-only="1"' : '' %>>
                    <i class="material-icons-outlined">shopping_cart</i><span>In den Warenkorb</span>
                  </button>
                </div>
              </div>
            </div>
            <% } %>
            <% } %>
            <% if (product.ingredients) { %>
            <div class="content-element-6">
              <div class="mad-tabs">
                <div role="tablist" aria-label="Product Info" class="mad-tabs-nav">
                  <span class="mad-active"><a id="tab-1-link" href="#tab-1" role="tab" aria-selected="true" aria-controls="tab-1" class="mad-tab-link">Zutaten</a></span>
                </div>
                <div class="mad-tabs-container">
                  <div id="tab-1" tabindex="0" role="tabpanel" aria-labelledby="tab-1-link" class="mad-tab">
                    <p><%= product.ingredients %></p>
                  </div>
                </div>
              </div>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <% if (related.length > 0) { %>
    <div class="content-element-13">
      <h3 class="mad-page-title">Das könnte Ihnen auch gefallen…</h3>
      <div class="mad-products item-col-4">
        <% related.forEach(function(p) { %>
        <div class="mad-col">
          <div class="mad-product">
            <figure class="mad-product-image">
              <a href="/speisekarte/produkt/<%= p.slug %>">
                <img src="<%= p.image || '/images/264x264_img1.jpg' %>" alt="<%= p.name %>">
              </a>
            </figure>
            <div class="mad-product-description">
              <h4 class="mad-product-title"><a href="/speisekarte/produkt/<%= p.slug %>" class="mad-link"><%= p.name %></a></h4>
              <p><%= p.description ? p.description.substring(0, 100) : '' %></p>
            </div>
            <div class="mad-product-calc">
              <span class="mad-product-price"><%= p.price.toFixed(2) %> €</span>
              <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>">In den Warenkorb</button>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>
</div>

<script>
window.PIZZA_EXTRA_PRICES = <%- JSON.stringify(pizzaExtras.prices) %>;
(function() {
  function updateDetailPrice() {
    var priceEl = document.getElementById('detailPrice');
    if (!priceEl) return;
    var radio = document.querySelector('input[name="detailSize"]:checked');
    var total = radio ? parseFloat(radio.value) || 0 : 0;
    document.querySelectorAll('[data-extras-for] input[type="checkbox"]:checked').forEach(function(cb) {
      total += parseFloat(cb.getAttribute('data-extra-price')) || 0;
    });
    priceEl.textContent = total.toFixed(2) + ' €';
  }
  document.addEventListener('change', function(e) {
    if (e.target && e.target.matches && e.target.matches('[data-extras-for] input[type="checkbox"], input[name="detailSize"]')) {
      updateDetailPrice();
    }
  });
  updateDetailPrice();
  window.updateDetailPrice = updateDetailPrice;
})();
(function() {
  var picker = document.querySelector('.size-picker-detail');
  if (!picker) return;
  function paintSelected(label) {
    label.style.borderColor = 'var(--primary)';
    label.style.background = '#2a230f';
    label.style.boxShadow = '0 0 0 3px rgba(212,175,55,0.25)';
    label.dataset.selected = '1';
  }
  function paintPlain(l) {
    l.style.borderColor = '#3a3a41';
    l.style.background = '#1d1d21';
    l.style.boxShadow = '0 2px 8px rgba(0,0,0,0.4)';
    delete l.dataset.selected;
  }
  var first = picker.querySelector('input[type="radio"]');
  if (first) {
    var label = first.closest('.size-option-detail');
    if (label) paintSelected(label);
  }
  picker.querySelectorAll('input[type="radio"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      picker.querySelectorAll('.size-option-detail').forEach(function(l) { paintPlain(l); });
      var label = this.closest('.size-option-detail');
      if (label) paintSelected(label);
      var priceEl = document.getElementById('detailPrice');
      if (priceEl) priceEl.textContent = parseFloat(this.value).toFixed(2) + ' €';
    });
  });
  picker.querySelectorAll('.size-option-detail').forEach(function(l) {
    l.addEventListener('mouseenter', function() {
      if (!this.dataset.selected) { this.style.borderColor = '#6b6455'; }
    });
    l.addEventListener('mouseleave', function() {
      if (!this.dataset.selected) { this.style.borderColor = '#3a3a41'; }
    });
  });
})();
</script>
<%- include('partials/footer') %>
