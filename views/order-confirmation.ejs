<%- include('partials/header') %>

<div class="page-hero confirmation-hero" style="background:linear-gradient(135deg,rgba(35,34,35,.5),rgba(35,34,35,.3)),url('/images/384x384_img2.jpg') center/cover">
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content">
    <div class="confirmation-icon"><i class="fas fa-check-circle" style="color:#d4af37"></i></div>
    <h1 class="page-hero-title" style="color:#d4af37">Bestellung erfolgreich!</h1>
    <p class="page-hero-subtitle" style="color:#d4af37">Vielen Dank für Ihre Bestellung</p>
  </div>
</div>

<section class="section confirmation-section">
  <div class="container">
    <div class="confirmation-card">
      <div class="confirmation-header">
        <div class="confirmation-check"><i class="fas fa-check"></i></div>
        <h2>Bestellung aufgegeben</h2>
        <p>Ihre Bestellung wurde erfolgreich übermittelt.</p>
      </div>
      <div class="confirmation-details">
        <div class="confirmation-row">
          <span>Bestellnummer</span>
          <strong><%= order.order_number %></strong>
        </div>
        <div class="confirmation-row">
          <span>Status</span>
          <strong class="status-<%= order.order_status %>"><%= order.order_status === 'neu' ? 'In Bearbeitung' : order.order_status %></strong>
        </div>
        <div class="confirmation-row">
          <span>Gesamtbetrag</span>
          <strong><%= parseFloat(order.total).toFixed(2) %> €</strong>
        </div>
        <% if (parseFloat(order.vat7 || 0) > 0 || parseFloat(order.vat19 || 0) > 0) { %>
        <div class="confirmation-row">
          <span>Inkl. MwSt</span>
          <strong><% if (parseFloat(order.vat7 || 0) > 0) { %>7%: <%= parseFloat(order.vat7).toFixed(2) %> €<% } %><% if (parseFloat(order.vat7 || 0) > 0 && parseFloat(order.vat19 || 0) > 0) { %> · <% } %><% if (parseFloat(order.vat19 || 0) > 0) { %>19%: <%= parseFloat(order.vat19).toFixed(2) %> €<% } %></strong>
        </div>
        <% } %>
        <div class="confirmation-row">
          <span>Bestellart</span>
          <strong><%= order.order_type === 'abholung' ? 'Abholung' : 'Lieferung' %></strong>
        </div>
        <div class="confirmation-row">
          <span>Zahlungsmethode</span>
          <strong><%= order.payment_method === 'bar' ? 'Barzahlung' : (order.payment_method === 'karte' ? 'Kartenzahlung' : 'Online-Zahlung') %></strong>
        </div>
      </div>
      <% if (order.wish_time) { %>
      <div class="delivery-time-box" style="border-color:#15803d">
        <i class="fas fa-calendar-check" style="color:#15803d"></i>
        <div>
          <strong>Gewünschter Termin: <%= new Date(String(order.wish_time).replace(' ', 'T') + 'Z').toLocaleString('de-DE', { timeZone: 'Europe/Berlin', weekday: 'long', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) %> Uhr</strong>
          <span><%= order.order_type === 'abholung' ? 'Ihre Bestellung ist zum Wunschtermin fertig zur Abholung.' : 'Ihre Bestellung wird zum Wunschtermin heiß geliefert.' %></span>
        </div>
      </div>
      <% } else if (order.order_type === 'abholung') { %>
      <div class="delivery-time-box">
        <i class="fas fa-clock"></i>
        <div>
          <strong>Bereit in ca. 15–20 Minuten</strong>
          <span>Ihre Bestellung wird frisch zubereitet und wartet dann auf Sie zur Abholung.</span>
        </div>
      </div>
      <% } else { %>
      <div class="delivery-time-box">
        <i class="fas fa-motorcycle"></i>
        <div>
          <strong>Lieferung in ca. 45 Minuten bis 1 Stunde</strong>
          <span>Ihre Bestellung wird frisch zubereitet und heiß zu Ihnen geliefert.</span>
        </div>
      </div>
      <% } %>
      <div class="confirmation-actions">
        <a href="/" class="btn btn-primary">Zur Startseite</a>
        <a href="/speisekarte" class="btn btn-outline">Weiter bestellen</a>
      </div>
      <%- include('partials/vat-note') %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
