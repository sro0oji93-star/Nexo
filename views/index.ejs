<%- include('partials/header') %>

<!-- Animated Hero Slider -->
<section class="hero mad-hero-animated <%= (typeof settings !== 'undefined' && settings.hero_theme === 'banner') ? 'hero-banner' : '' %>" style="position:relative;overflow:hidden;display:flex;align-items:center">
  <div class="hero-overlay" style="position:absolute;inset:0;background:rgba(0,0,0,.35);z-index:1"></div>

  <% if (heroSlides && heroSlides.length > 0) { %>
  <% heroSlides.forEach(function(slide, idx) { %>
  <div class="hero-slide-items" style="width:100%;z-index:2;background:url('<%= slide.bg_image || '/images/revolution/6cbea-bg1.jpg' %>') center/cover no-repeat;display:<%= idx === 0 ? 'flex' : 'none' %>;align-items:center;min-height:92vh" data-slide-idx="<%= idx %>">
    <div class="hero-inner" style="width:100%;max-width:1400px;margin:0 auto;padding:120px 20px 60px">
      <div class="hero-slide-inner" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:30px">
        <div class="mad-hero-text" style="flex:1;min-width:320px;max-width:600px">
          <div class="mad-hero-title" style="font-family:'Josefin Sans',sans-serif;font-weight:700;font-style:italic;color:#fff;text-shadow:3px 3px 0 var(--primary),5px 5px 0 var(--primary);line-height:1.2">
            <% if (slide.line1) { %><span class="hero-title-gold" style="font-size:clamp(30px,4vw,60px);display:inline-block"><%= slide.line1 %></span><br><% } %>
            <% if (slide.line2) { %><span class="hero-title-gold" style="font-size:clamp(38px,5.5vw,80px);display:inline-block"><%= slide.line2 %></span><br><% } %>
            <% if (slide.line3) { %><span class="hero-title-gold" style="font-size:clamp(26px,3.5vw,52px);display:inline-block"><%= slide.line3 %></span><% } %>
          </div>
          <div style="margin-top:20px;display:flex;gap:36px;flex-wrap:wrap;align-items:flex-start">
            <% if (slide.price1) { %>
            <span class="hero-price-gold" style="font-family:'Josefin Sans',sans-serif;font-size:clamp(30px,4vw,64px);font-weight:700;font-style:italic;color:#d4af37;text-shadow:3px 3px 0 var(--primary),4px 4px 0 var(--primary);line-height:1"><%= slide.price1 %><% if (slide.price1_cents) { %><span style="font-size:clamp(16px,2vw,36px)"><%= slide.price1_cents %></span><% } %> <span style="display:block;width:fit-content;margin-top:10px;font-size:clamp(10px,0.9vw,13px);font-weight:700;letter-spacing:3px;color:var(--secondary,#f5d67b);border:1px solid var(--primary,#d4af37);border-radius:20px;padding:4px 14px;background:rgba(0,0,0,.45);white-space:nowrap"><%= slide.price1_tag || 'ABHOLUNG' %></span></span>
            <% } %>
            <% if (slide.price2) { %>
            <span class="hero-price-gold" style="font-family:'Josefin Sans',sans-serif;font-size:clamp(30px,4vw,64px);font-weight:700;font-style:italic;color:#d4af37;text-shadow:3px 3px 0 var(--primary),4px 4px 0 var(--primary);line-height:1"><%= slide.price2 %><% if (slide.price2_cents) { %><span style="font-size:clamp(16px,2vw,36px)"><%= slide.price2_cents %></span><% } %> <span style="display:block;width:fit-content;margin-top:10px;font-size:clamp(10px,0.9vw,13px);font-weight:700;letter-spacing:3px;color:var(--secondary,#f5d67b);border:1px solid var(--primary,#d4af37);border-radius:20px;padding:4px 14px;background:rgba(0,0,0,.45);white-space:nowrap"><%= slide.price2_tag || 'LIEFERUNG' %></span></span>
            <% } %>
          </div>
          <p style="margin-top:15px;font-size:16px;color:rgba(255,255,255,.85);max-width:80%"><%= slide.description || '' %></p>
          <% var heroAddSlug = null; if (slide.button_link && slide.button_link.indexOf('?add=') !== -1) { heroAddSlug = slide.button_link.split('?add=')[1].split('&')[0]; } %>
          <% var isNightDeal = heroAddSlug === 'deal-night-abholung'; %>
          <% var isMittagDeal = heroAddSlug === 'nexo-mittag-deal'; %>
          <% var telHref = 'tel:' + String((typeof settings !== 'undefined' && settings.phone) ? settings.phone : '041314006817').replace(/[^+\d]/g, ''); %>
          <% var heroDealList = (typeof heroDeals !== 'undefined' && heroDeals) ? heroDeals : products; %>
          <% var heroDeal = heroAddSlug ? heroDealList.find(function(x) { return x.slug === heroAddSlug; }) : null; %>
          <% if (isNightDeal) { %>
          <a href="<%= telHref %>" class="btn btn-big btn-style-3" style="margin-top:25px;display:inline-block">📞 JETZT ANRUFEN</a>
          <% } else if (isMittagDeal) { %>
          <a href="/speisekarte/kategorie/nexo-deals" class="btn btn-big btn-style-3" style="margin-top:25px;display:inline-block"><%= slide.button_text || 'JETZT BESTELLEN' %></a>
          <% } else { %>
          <% if (!isNightDeal && heroDeal && heroDeal.sizes) { var heroSizes = JSON.parse(heroDeal.sizes); %>
          <div class="hero-deal-picker" data-deal-id="<%= heroDeal.id %>" style="margin-top:22px;display:flex;gap:8px;flex-wrap:wrap">
            <% heroSizes.forEach(function(s, si) { %>
            <label style="cursor:pointer;padding:8px 18px;border:2px solid <%= si === 0 ? '#d4af37' : 'rgba(255,255,255,.5)' %>;border-radius:12px;font-size:14px;background:<%= si === 0 ? 'rgba(212,175,55,.15)' : 'rgba(255,255,255,.08)' %>;color:#fff;font-weight:700">
              <input type="radio" name="hero_size_<%= slide.id || idx %>" value="<%= s.price %>" data-label="<%= s.label %>" style="display:none" <%= si === 0 ? 'checked' : '' %>>
              <%= s.label %> · <%= s.price.toFixed(2).replace('.', ',') %> €
            </label>
            <% }); %>
          </div>
          <button type="button" class="btn btn-big btn-style-3 hero-add-to-cart" data-id="<%= heroDeal.id %>" data-name="<%= heroDeal.name %>" data-slide="<%= idx %>"<%- heroDeal.slug === 'deal-night-abholung' ? ' data-pickup-only="1"' : '' %> style="margin-top:12px;display:inline-block;cursor:pointer"><%= slide.button_text || 'JETZT BESTELLEN' %></button>
          <% } else if (heroDeal) { %>
          <button type="button" class="btn btn-big btn-style-3 hero-add-to-cart" data-id="<%= heroDeal.id %>" data-name="<%= heroDeal.name %>" data-price="<%= heroDeal.price %>" data-slide="<%= idx %>"<%- heroDeal.slug === 'deal-night-abholung' ? ' data-pickup-only="1"' : '' %> style="margin-top:25px;display:inline-block;cursor:pointer"><%= slide.button_text || 'JETZT BESTELLEN' %></button>
          <% } else { %>
          <a href="<%= slide.button_link || '/speisekarte' %>" class="btn btn-big btn-style-3" style="margin-top:25px;display:inline-block"><%= slide.button_text || 'JETZT BESTELLEN' %></a>
          <% } %>
          <% } %>
        </div>
        <div style="flex:1;min-width:350px;max-width:700px;position:relative;min-height:550px;display:flex;align-items:center;justify-content:center">
          <div style="position:relative;width:100%;height:100%;display:flex;align-items:center;justify-content:center">
            <img src="<%= slide.main_image || '/images/revolution/75ec1-big1.png' %>" alt="" style="max-width:100%;max-height:550px;object-fit:contain;animation:gentleFloat 3.5s ease-in-out infinite">
            <% if (slide.drink_tl) { %><img src="<%= slide.drink_tl %>" alt="" style="position:absolute;top:20%;left:-2%;width:22%;animation:revFloat 3.5s ease-in-out infinite"><% } %>
            <% if (slide.drink_tr) { %><img src="<%= slide.drink_tr %>" alt="" style="position:absolute;top:24%;right:-3%;width:20%;animation:revFloat 3.5s ease-in-out infinite 0.3s"><% } %>
            <% if (slide.drink_br) { %><img src="<%= slide.drink_br %>" alt="" style="position:absolute;bottom:2%;right:0;width:20%;animation:revFloat 3.5s ease-in-out infinite 0.6s"><% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% }); } %>
</section>

<style>
@keyframes gentleFloat { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-8px); } }
@keyframes revFloat { 0%,100% { transform:rotate(-6deg) translateY(0); } 50% { transform:rotate(6deg) translateY(-5px); } }
.hero-slide-items .hero-slide-inner > div > div:first-child { animation:slideInLeft 0.7s ease-out 0.3s both; }
.hero-slide-items .hero-slide-inner > div > div:last-child { animation:slideInRight 0.8s ease-out 0.1s both; }
@keyframes slideInLeft { 0% { transform:translateX(-40px);opacity:0; } 100% { transform:translateX(0);opacity:1; } }
@keyframes slideInRight { 0% { transform:translateX(200px) rotate(60deg);opacity:0; } 100% { transform:translateX(0) rotate(0deg);opacity:1; } }
@media (max-width:767px) {
  .hero-slide-items { min-height:auto !important; }
  .hero-slide-items > .hero-inner > div { flex-direction:column !important; }
  .hero-slide-items .mad-hero-text { max-width:100% !important;min-width:auto !important;text-align:center; }
  .hero-slide-items .mad-hero-text p { max-width:100% !important; }
  .hero-slide-items .mad-hero-title span { font-size:clamp(24px,7vw,42px) !important; }
  .hero-slide-items .mad-hero-title span:nth-child(3) { font-size:clamp(32px,9vw,55px) !important; }
  .hero-slide-items .mad-hero-title br + span { font-size:clamp(20px,5vw,36px) !important; }
  .hero-slide-items div[style*="flex:1;min-width:350px"] { min-width:auto !important;min-height:auto !important;max-width:300px !important; }
  .hero-slide-items img[style*="max-width:100%"] { max-height:300px !important; }
  .hero-slide-items img[style*="position:absolute"] { width:22% !important; }
  .hero-slide-items img[style*="right:-2%"] { width:18% !important; }
  .hero-slide-items img[style*="bottom:-2%"] { width:16% !important; }
}
</style>

<script>
(function() {
  var slides = document.querySelectorAll('.hero-slide-items[data-slide-idx]');
  if (slides.length < 2) return;
  var current = 0;
  var interval;
  function showSlide(i) {
    slides.forEach(function(s, idx) {
      s.style.display = idx === i ? 'flex' : 'none';
    });
    current = i;
  }
  interval = setInterval(function() { showSlide((current + 1) % slides.length); }, 6000);
})();
</script>

<script>
/* Hero-Deal: Abholung/Lieferung-Pills + Direkt-Add in den Warenkorb */
(function() {
  document.querySelectorAll('.hero-deal-picker').forEach(function(picker) {
    picker.querySelectorAll('input[type="radio"]').forEach(function(radio) {
      radio.addEventListener('change', function() {
        picker.querySelectorAll('label').forEach(function(l) {
          l.style.borderColor = 'rgba(255,255,255,.5)';
          l.style.background = 'rgba(255,255,255,.08)';
        });
        var label = this.closest('label');
        if (label) { label.style.borderColor = '#d4af37'; label.style.background = 'rgba(212,175,55,.15)'; }
      });
    });
  });
  document.addEventListener('click', function(e) {
    var btn = e.target && e.target.closest ? e.target.closest('.hero-add-to-cart') : null;
    if (!btn) return;
    e.preventDefault();
    var id = btn.getAttribute('data-id');
    var name = btn.getAttribute('data-name');
    var pickupOnly = btn.getAttribute('data-pickup-only') === '1';
    var container = btn.closest('.mad-hero-text');
    var radio = container ? container.querySelector('.hero-deal-picker input[type="radio"]:checked') : null;
    if (window.Cart && window.Cart.addItem) {
      if (radio) {
        var size = { label: radio.getAttribute('data-label'), price: parseFloat(radio.value) };
        window.Cart.addItem(id, name, size.price, 1, size, [], pickupOnly);
      } else {
        window.Cart.addItem(id, name, parseFloat(btn.getAttribute('data-price')), 1, null, [], pickupOnly);
      }
      setTimeout(function() { window.location.href = '/warenkorb'; }, 400);
    } else {
      window.location.href = '/warenkorb';
    }
  });
})();
</script>

<div class="container">

  <!-- Category Icons -->
  <div class="mad-menu-box with-slide-top">
    <% categories.forEach(function(c) { %>
    <div class="mad-col">
      <a href="/speisekarte/kategorie/<%= c.slug %>" class="mad-menu-item">
        <i class="mad-menu-icon">
          <% 
            var icons = { pizza:'fa-pizza-slice', burger:'fa-hamburger', croque:'fa-bread-slice', salat:'fa-leaf', pasta:'fa-utensils', schnitzel:'fa-drumstick-bite', snacks:'fa-cookie', getraenke:'fa-wine-glass-alt', 'snack-rolls':'fa-egg-roll', 'saucen-dips':'fa-tint', dessert:'fa-ice-cream', beilagen:'fa-cheese', 'nexo-box':'fa-box', 'kids-menue':'fa-child', milkshake:'fa-cocktail' };
            var icon = icons[c.slug] || 'fa-utensils';
          %>
          <i class="fas <%= icon %>" style="font-size:32px;color:var(--primary)"></i>
        </i>
        <h6 class="mad-menu-title"><%= c.name %></h6>
      </a>
    </div>
    <% }); %>
  </div>

</div>

<!-- All Products -->
<div class="mad-section">
  <div class="container">
    <div class="mad-products mad-grid mad-grid--cols-4">
      <% products.forEach(function(p) { %>
      <div class="mad-grid-item">
        <div class="mad-product">
          <figure class="mad-product-image">
            <% if (p.image) { %>
            <a href="/speisekarte/produkt/<%= p.slug %>"><img loading="lazy" src="<%= p.image %>" alt="<%= p.name %>" onerror="this.style.display='none';this.parentElement.innerHTML='<i class=&quot;fas fa-utensils&quot; style=&quot;font-size:48px;color:#ccc&quot;></i>'"></a>
            <% } else { %>
            <a href="/speisekarte/produkt/<%= p.slug %>" style="display:flex;align-items:center;justify-content:center;height:200px;background:#f8f5f0"><i class="fas fa-utensils" style="font-size:48px;color:#ccc"></i></a>
            <% } %>
          </figure>
          <div class="mad-product-description">
            <h4 class="mad-product-title"><a href="/speisekarte/produkt/<%= p.slug %>" class="mad-link"><%= p.name %></a><% if (p.is_featured) { %> <span style="display:inline-block;font-size:10px;font-weight:700;color:#0a0a0a;background:linear-gradient(135deg,#f5d67b,#d4af37);border-radius:50px;padding:2px 8px;vertical-align:middle;white-space:nowrap">⭐ Empfohlen</span><% } %></h4>
            <p><%= p.description ? p.description.substring(0, 80) + (p.description.length > 80 ? '...' : '') : '' %></p>
          </div>
          <div class="mad-product-calc">
            <% if (!p.is_available) { %>
            <span style="display:inline-block;padding:8px 18px;border-radius:50px;background:rgba(220,53,53,.1);color:#dc3545;font-size:12px;font-weight:700">Ausverkauft</span>
            <% } else { %>
            <% if (p.sizes) { var sz = JSON.parse(p.sizes); var minP = Math.min.apply(null, sz.map(function(s){return s.price})); %>
            <span class="mad-product-price">ab <%= minP.toFixed(2) %> €</span>
            <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-has-sizes="1">In den Warenkorb</button>
            <% } else { %>
            <span class="mad-product-price"><%= p.price.toFixed(2) %> €</span>
            <% if (['box-1', 'box-2', 'box-3', 'mix-milkshake'].indexOf(p.slug) !== -1) { %>
            <a href="/speisekarte/produkt/<%= p.slug %>" class="btn btn-style-3 btn-small">Auswählen</a>
            <% } else { %>
            <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>">In den Warenkorb</button>
            <% } %>
            <% } %>
            <% } %>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    <div class="align-center">
      <a href="/speisekarte" class="btn btn-style-2 btn-big">Alle ansehen</a>
    </div>
  </div>
</div>

