          <% 
            var icons = { pizza:'fa-pizza-slice', burger:'fa-hamburger', croque:'fa-bread-slice', salat:'fa-leaf', pasta:'fa-utensils', schnitzel:'fa-drumstick-bite', snacks:'fa-cookie', getraenke:'fa-wine-glass-alt', 'snack-rolls':'fa-egg-roll', 'saucen-dips':'fa-tint', dessert:'fa-ice-cream', beilagen:'fa-cheese', 'nexo-box':'fa-box', 'kids-menue':'fa-child', milkshake:'fa-cocktail' };
            var icon = icons[c.slug] || 'fa-utensils';
          %>
