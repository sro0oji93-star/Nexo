<%- include('partials/header') %>

<div class="page-hero contact-hero" style="background:linear-gradient(135deg,rgba(35,34,35,.5),rgba(35,34,35,.3)),url('/images/688x944_img1.jpg') center/cover">
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content">
    <div class="page-hero-badge">KONTAKT</div>
    <h1 class="page-hero-title" style="color:#fff">Kontaktieren Sie uns</h1>
    <p class="page-hero-subtitle" style="color:rgba(255,255,255,.7)">Wir freuen uns auf Ihre Nachricht</p>
  </div>
</div>

<section class="section contact-section">
  <div class="container">
    <div class="contact-layout">
      <div class="contact-info">
        <div class="contact-card">
          <div class="contact-icon"><i class="fas fa-map-marker-alt"></i></div>
          <h3>Adresse</h3>
          <p><%= typeof settings !== 'undefined' && settings.address ? settings.address : 'Friedrichstraße 42, 10117 Berlin' %></p>
        </div>
        <div class="contact-card">
          <div class="contact-icon"><i class="fas fa-phone"></i></div>
          <h3>Telefon</h3>
          <p><a href="tel:<%= typeof settings !== 'undefined' && settings.phone ? settings.phone : '' %>"><%= typeof settings !== 'undefined' && settings.phone ? settings.phone : '+49 30 123456789' %></a></p>
        </div>
        <div class="contact-card">
          <div class="contact-icon"><i class="fas fa-envelope"></i></div>
          <h3>E-Mail</h3>
          <p><a href="mailto:<%= typeof settings !== 'undefined' && settings.email ? settings.email : '' %>"><%= typeof settings !== 'undefined' && settings.email ? settings.email : 'info@feinschmeckerei.de' %></a></p>
        </div>
        <div class="contact-card">
          <div class="contact-icon"><i class="fas fa-clock"></i></div>
          <h3>Öffnungszeiten</h3>
          <p><%= typeof settings !== 'undefined' && settings.opening_hours ? settings.opening_hours : 'Mo–So: 11:30 – 22:30' %></p>
        </div>
        <div class="contact-social">
          <h3>Folgen Sie uns</h3>
          <div class="contact-social-links">
            <a href="<%= typeof settings !== 'undefined' && settings.social_instagram ? settings.social_instagram : '#' %>" target="_blank" rel="noopener" class="social-link-lg"><i class="fab fa-instagram"></i></a>
            <a href="<%= typeof settings !== 'undefined' && settings.social_facebook ? settings.social_facebook : '#' %>" target="_blank" rel="noopener" class="social-link-lg"><i class="fab fa-facebook-f"></i></a>
            <a href="<%= typeof settings !== 'undefined' && settings.social_tiktok ? settings.social_tiktok : '#' %>" target="_blank" rel="noopener" class="social-link-lg"><i class="fab fa-tiktok"></i></a>
          </div>
        </div>
      </div>
      <div class="contact-form-container">
        <% if (typeof session !== 'undefined' && session.contactFlash) { %>
        <div class="alert alert-success">
          <i class="fas fa-check-circle"></i> <%= session.contactFlash %>
        </div>
        <% session.contactFlash = null; %>
        <% } %>
        <form action="/kontakt" method="POST" class="contact-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <h2>Schreiben Sie uns</h2>
          <div class="form-group">
            <label for="name">Name *</label>
            <input type="text" id="name" name="name" required placeholder="Ihr Name">
          </div>
          <div class="form-group">
            <input type="email" id="email" name="email" required placeholder="ihre@email.de" aria-label="E-Mail">
          </div>
          <div class="form-group">
            <textarea id="message" name="message" required rows="6" placeholder="Ihre Nachricht an uns..." aria-label="Nachricht"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-paper-plane"></i> Nachricht senden
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<section class="section map-section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">ANFAHRT</span>
      <h2 class="section-title">So finden Sie uns</h2>
    </div>
  </div>
  <div class="map-container">
    <div class="map-placeholder" id="mapContainer">
      <div class="map-overlay">
        <i class="fas fa-map-marked-alt"></i>
        <h3><%= typeof settings !== 'undefined' && settings.address ? settings.address : 'Friedrichstraße 42, 10117 Berlin' %></h3>
        <p>Berlin, Deutschland</p>
        <a href="https://maps.google.com/?q=<%= typeof settings !== 'undefined' && settings.latitude ? settings.latitude : '52.520008' %>,<%= typeof settings !== 'undefined' && settings.longitude ? settings.longitude : '13.404954' %>" target="_blank" rel="noopener" class="btn btn-primary btn-sm">
          <i class="fas fa-external-link-alt"></i> In Google Maps öffnen
        </a>
      </div>
      <iframe 
        src="https://maps.google.com/maps?q=<%= typeof settings !== 'undefined' && settings.latitude ? settings.latitude : '52.520008' %>,<%= typeof settings !== 'undefined' && settings.longitude ? settings.longitude : '13.404954' %>&z=15&output=embed"
        width="100%"
        height="450"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
